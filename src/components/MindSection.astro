---
const tiles = [
  {
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    title: 'Planning ahead',
    body: 'In experiments, ravens set aside tools and tokens they would only need later — a skill once thought to be uniquely great-ape.',
  },
  {
    icon: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
    title: 'Hide &amp; deceive',
    body: 'They cache food, and when they notice another raven watching, they move it to a new hiding place.',
  },
  {
    icon: '<path d="M4 10v4"/><path d="M8 7v10"/><path d="M12 4v16"/><path d="M16 8v8"/><path d="M20 11v2"/>',
    title: 'A hundred voices',
    body: 'Beyond the deep croak, ravens make knocks, bells and gurgles — and can mimic other animals and even human speech.',
  },
  {
    icon: '<path d="M3 17c4 0 5-10 9-10s5 10 9 10"/><path d="M3 21h18"/>',
    title: 'Built for play',
    body: 'Ravens have been seen sliding down snowy slopes, flying upside down and tumbling through the air for no reward but fun.',
  },
  {
    icon: '<circle cx="9" cy="12" r="5"/><circle cx="15" cy="12" r="5"/>',
    title: 'Partners for life',
    body: 'Breeding pairs usually stay together for years, holding a territory and performing paired aerial displays.',
  },
  {
    icon: '<path d="M4 18l4-12 4 8 4-6 4 10"/>',
    title: 'Wolf-birds',
    body: 'Ravens follow wolf packs to share their kills — a bond old enough to echo in Odin\'s companions, the wolves Geri and Freki.',
  },
];
---

<section id="mind" aria-labelledby="mind-title" style="max-width:1280px;margin:0 auto;padding:120px 32px 110px">
  <div class="reveal" style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:52px">
    <div>
      <p style="margin:0 0 12px;font-size:12px;letter-spacing:.35em;text-transform:uppercase;color:#d4ae5a">III · Mind &amp; Behaviour</p>
      <h2 id="mind-title" class="serif" style="margin:0;font-size:clamp(44px,6vw,72px);font-weight:600;line-height:1;color:#ecebe6">A mind in black feathers.</h2>
    </div>
    <p style="margin:0;max-width:420px;font-size:16px;line-height:1.65;color:#a3abb8">
      Ravens are counted among the most intelligent animals studied — they plan, deceive, play and remember faces.
    </p>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1px;background:rgba(232,230,225,.12);border:1px solid rgba(232,230,225,.12)">
    {tiles.map(({ icon, title, body }) => (
      <div class="reveal" style="background:#0b0d12;padding:36px 32px">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#d4ae5a"
          stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          style="width:34px;height:34px" set:html={icon}/>
        <h3 class="serif" style="margin:18px 0 8px;font-size:26px;font-weight:600;color:#ecebe6" set:html={title}/>
        <p style="margin:0;font-size:15px;line-height:1.65;color:#a3abb8">{body}</p>
      </div>
    ))}
  </div>
</section>
