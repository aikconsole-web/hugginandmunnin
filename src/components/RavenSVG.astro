---
/**
 * Reusable raven SVG in flight.
 * Variant flags drive which optional layers are shown/hidden.
 * Pass dataDynamic=true for the atlas detail bird (uses data-flag attributes for JS switching).
 */
interface Props {
  tail?:        'wedge' | 'fan' | 'short';
  neck?:        boolean;
  thick?:       boolean;
  brown?:       boolean;
  whiteEye?:    boolean;
  ariaLabel?:   string;
  dataDynamic?: boolean;  // atlas detail — layers use data-flag instead of static class
  moonlit?:     boolean;  // Huginn & Muninn palette
}

const {
  tail      = 'wedge',
  neck      = false,
  thick     = false,
  brown     = false,
  whiteEye  = false,
  ariaLabel,
  dataDynamic = false,
  moonlit   = false,
} = Astro.props;

// Static flags (used when dataDynamic is false)
const tWedge = tail === 'wedge';
const tFan   = tail === 'fan';
const tShort = tail === 'short';
const bN     = !thick;
const bT     = thick;

function cls(active: boolean, flag?: string): string {
  if (dataDynamic && flag) return '';  // JS will manage via data-flag
  return active ? '' : 'off';
}

// For dataDynamic bird, every optional layer gets data-flag="flagName"
// For static birds, they just get class="off" or class=""
const df = (flag: string) => dataDynamic ? { 'data-flag': flag } : {};
const dfe = dataDynamic ? { 'data-flag-eye': '' } : {};

const W = moonlit ? 'url(#rvLit)'    : 'url(#rvBody)';
const WF= moonlit ? 'url(#rvLitFar)' : 'url(#rvWingFar)';
const WN= moonlit ? 'url(#rvLit)'    : 'url(#rvWing)';
---

<svg
  viewBox="0 -24 200 168"
  role={ariaLabel ? 'img' : undefined}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : 'true'}
  data-aria-suffix={dataDynamic ? ' in flight' : undefined}
  style="display:block;width:100%;height:auto;overflow:visible"
>
  <g class="bl">
    <!-- Far wing -->
    <g transform="translate(-10 3)">
      <g class="arm">
        <path fill={WF} d="M126 68 C 126 50, 120 32, 112 20 L 102 23 C 99 30, 96 36, 93 42 C 91 46, 89 50, 89 54 L 92 57 L 89 61 L 93 64 L 91 69 Z"/>
        <g class="hand">
          <path fill={WF} d="M114 22 C 110 14, 102 8, 94 6 C 89 12, 90 20, 100 27 Z M106 12 C 102 3, 98 -4, 93 -12 C 94 -3, 97 6, 101 16 Z M101 10 C 96 3, 90 -3, 82 -8 C 86 0, 91 7, 97 14 Z M97 11 C 91 6, 84 2, 75 -1 C 80 6, 87 11, 94 16 Z M95 15 C 88 12, 81 11, 72 10 C 78 16, 85 19, 93 20 Z M94 20 C 87 20, 81 21, 73 23 C 79 27, 86 27, 95 26 Z M95 25 C 89 27, 84 30, 78 33 C 85 35, 90 33, 96 30 Z"/>
        </g>
      </g>
    </g>

    <!-- Tail: wedge -->
    <path
      class={dataDynamic ? undefined : (tWedge ? '' : 'off')}
      {...df('tWedge')}
      fill={W}
      d="M76 74 L 30 69 L 16 79 L 30 89 L 76 84 Z"
    />
    <path
      class={dataDynamic ? undefined : (tWedge ? '' : 'off')}
      {...df('tWedge')}
      fill="none" stroke="rgba(150,170,220,.16)" stroke-width=".8"
      d="M74 77 L 27 75 M74 79 L 18 79 M74 81 L 27 83"
    />
    <!-- Tail: fan -->
    <path
      class={dataDynamic ? undefined : (tFan ? '' : 'off')}
      {...df('tFan')}
      fill={W}
      d="M76 74 L 38 68 Q 22 79 38 90 L 76 84 Z"
    />
    <!-- Tail: short -->
    <path
      class={dataDynamic ? undefined : (tShort ? '' : 'off')}
      {...df('tShort')}
      fill={W}
      d="M78 74 L 52 70 Q 42 79 52 88 L 78 84 Z"
    />

    <!-- Feet -->
    <path fill="#07080b" d="M108 86 L 98 92 L 100 93 L 110 88 Z"/>

    <!-- Body -->
    <path fill={W} d="M150 62 C 140 58, 126 60, 114 64 C 98 68, 86 70, 74 73 L 74 85 C 90 89, 112 92, 128 88 C 140 85, 150 80, 156 74 Z"/>
    <path fill="none" stroke="rgba(185,200,235,.3)" stroke-width="1" d="M148 61 C 136 58, 120 61, 106 66 C 94 69, 84 71, 76 73"/>

    <!-- Brown-neck sheen (optional) -->
    <path
      class={dataDynamic ? undefined : (brown ? '' : 'off')}
      {...df('bn')}
      fill="rgba(124,80,44,.6)"
      d="M134 62 C 142 58, 152 58, 158 64 C 156 74, 146 80, 136 80 C 132 74, 132 68, 134 62 Z"
    />

    <!-- Head -->
    <path fill={W} d="M144 62 C 150 55, 162 55, 167 61 C 170 66, 168 71, 163 74 C 157 77, 148 76, 144 71 Z"/>
    <path fill="none" stroke="rgba(185,200,235,.3)" stroke-width=".8" d="M146 60 C 152 56, 160 56, 165 60"/>

    <!-- Nape patch (white-necked species) -->
    <path
      class={dataDynamic ? undefined : (neck ? '' : 'off')}
      {...df('nk')}
      fill="#e7e2d6"
      d="M140 62 C 143 57, 150 56, 153 59 C 152 64, 146 68, 141 67 Z"
    />

    <!-- Hackles -->
    <path fill="#090a0e" d="M148 73 L 145 83 L 150 78 L 151 86 L 154 79 L 157 85 L 158 77 L 161 80 L 161 73 Z"/>

    <!-- Bill: normal -->
    <path
      class={dataDynamic ? undefined : (bN ? '' : 'off')}
      {...df('bN')}
      fill="url(#rvBill)"
      d="M165 60 C 174 59, 183 62, 189 67 C 186 68, 182 69, 176 69 L 165 70 Z"
    />
    <path
      class={dataDynamic ? undefined : (bN ? '' : 'off')}
      {...df('bN')}
      fill="none" stroke="rgba(170,180,200,.35)" stroke-width=".7"
      d="M166 65.5 L 184 67"
    />
    <!-- Bill: thick -->
    <path
      class={dataDynamic ? undefined : (bT ? '' : 'off')}
      {...df('bT')}
      fill="url(#rvBill)"
      d="M164 57 C 176 55, 188 59, 195 67 C 190 69, 184 71, 176 71 L 164 72 Z"
    />
    <path
      class={dataDynamic ? undefined : (bT ? '' : 'off')}
      {...df('bT')}
      fill="#d9d3c5"
      d="M188 63 C 191 64, 194 66, 195 67 C 192 68.5, 189 69.5, 186 70 Z"
    />

    <!-- Nasal bristles -->
    <path fill="#0d0e12" d="M163 60 C 167 58, 171 59, 173 61 L 165 64 Z"/>

    <!-- Eye -->
    <circle cx="158" cy="63" r="2.1" fill={whiteEye ? '#ece7da' : '#16181e'} {...dfe}/>
    <!-- Pupil (white-eye species only) -->
    <circle
      class={dataDynamic ? undefined : (whiteEye ? '' : 'off')}
      {...df('pupil')}
      cx="158" cy="63" r="1" fill="#050505"
    />
    <!-- Eye glint -->
    <circle cx="158.8" cy="62.2" r=".6" fill="#ffffff" opacity=".85"/>

    <!-- Near wing -->
    <g class="arm">
      <path fill={WN} d="M126 68 C 126 50, 120 32, 112 20 L 102 23 C 99 30, 96 36, 93 42 C 91 46, 89 50, 89 54 L 92 57 L 89 61 L 93 64 L 91 69 Z"/>
      {!moonlit && <path fill={W} opacity=".85" d="M126 68 C 126 54, 121 40, 114 28 C 108 36, 103 48, 101 60 C 108 64, 118 67, 126 68 Z"/>}
      {moonlit  && <path fill={W} opacity=".85" d="M126 68 C 126 54, 121 40, 114 28 C 108 36, 103 48, 101 60 C 108 64, 118 67, 126 68 Z"/>}
      <path fill="none" stroke="rgba(150,170,220,.18)" stroke-width=".8" d="M118 66 L 96 44 M112 67 L 92 52 M106 68 L 90 60 M100 68 L 91 66"/>
      <g class="hand">
        <path fill={WN} d="M114 22 C 110 14, 102 8, 94 6 C 89 12, 90 20, 100 27 Z M106 12 C 102 3, 98 -4, 93 -12 C 94 -3, 97 6, 101 16 Z M101 10 C 96 3, 90 -3, 82 -8 C 86 0, 91 7, 97 14 Z M97 11 C 91 6, 84 2, 75 -1 C 80 6, 87 11, 94 16 Z M95 15 C 88 12, 81 11, 72 10 C 78 16, 85 19, 93 20 Z M94 20 C 87 20, 81 21, 73 23 C 79 27, 86 27, 95 26 Z M95 25 C 89 27, 84 30, 78 33 C 85 35, 90 33, 96 30 Z"/>
        <path fill="none" stroke="rgba(150,170,220,.2)" stroke-width=".7" d="M103 14 L 94 -9 M99 12 L 84 -6 M95 13 L 77 1 M94 17 L 74 12 M94 23 L 75 24"/>
      </g>
    </g>
  </g>
</svg>
