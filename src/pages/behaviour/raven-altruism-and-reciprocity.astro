const title       = 'Raven Altruism and Reciprocity: Do Ravens Help Each Other?';
const description = 'Ravens show prosocial behaviour — consoling distressed individuals, sharing food with allies, and apparently reciprocating help over time. This chapter examines the evidence for altruism, reciprocal altruism, and cooperation in ravens.';
const path        = '/behaviour/raven-altruism-and-reciprocity/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Behaviour', url: '/behaviour/' },
  { name: 'Raven Altruism and Reciprocity', url: path },
];

const faq = [
  { q: 'Are ravens altruistic?', a: 'Ravens show prosocial behaviour that in some contexts appears altruistic. The best-documented example is consolation: after a conflict between ravens, uninvolved third parties approach and affiliate with the loser — a costly behaviour with no immediate benefit to the consoler. Ravens also share food preferentially with allies and partners, and appear to track and reciprocate favours over time. Whether this constitutes "true altruism" (costly behaviour with no selfish benefit) is debated; some forms may be better described as reciprocal altruism (cooperation that benefits both parties over time).' },
  { q: 'Do ravens share food?', a: 'Ravens do share food, but selectively. Food sharing occurs primarily: within bonded pairs (mates share food year-round); between allies in non-breeding groups (birds that support each other in conflicts share food); and from adults to young during the post-fledging dependency period. Ravens do not share food indiscriminately — they preferentially share with individuals they have established affiliative relationships with, suggesting they track social relationships and use food sharing to maintain them.' },
  { q: 'Do ravens remember who helped them?', a: 'Evidence from Bugnyar\'s group suggests ravens track positive and negative social interactions and adjust future behaviour accordingly. Ravens preferentially affiliate with individuals who helped them in past conflicts and appear to remember specific instances of support or non-support. This tracking of social debts (who owes whom) is a form of reciprocal altruism that requires individual recognition and memory — both of which ravens clearly possess.' },
];
---

