const description = 'Young ravens spend years in a non-breeding "floater" period before establishing territories and pair bonds. This chapter examines juvenile raven behaviour from fledging to independent life, the social dynamics of non-breeding flocks, and how ravens eventually transition from floater to territorial breeder.';
const path        = '/behaviour/raven-juveniles-and-learning/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
