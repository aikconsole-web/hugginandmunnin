const title       = 'Do Ravens Migrate? Movement Patterns and Dispersal';
const description = 'Most Common Raven populations are resident year-round. Some northern populations make seasonal movements. Juvenile dispersal differs from adult territorial behaviour. What the evidence shows.';
const path        = '/behaviour/raven-migration/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Behaviour', url: '/behaviour/' },
  { name: 'Raven Migration', url: path },
];

const faq = [
  { q: 'Do ravens migrate?', a: 'Most Common Raven populations are year-round residents — they do not undergo regular seasonal migration. However, northern populations at the edge of the range (high Arctic Canada, northernmost Scandinavia) make southward movements in winter. Juvenile and non-breeding ravens are significantly more nomadic than established territorial adults — young birds disperse widely before settling. The question on the Q&A page covers this in brief; this behaviour chapter gives full detail.' },
];
---

