import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Fan-tailed Raven vs Brown-necked Raven: How to Tell Them Apart';
const description = 'Fan-tailed Raven and Brown-necked Raven are the two most confusing corvids of North Africa and the Middle East. The fan-shaped tail and shorter bill separate the Fan-tailed; neck tone is unreliable in the field.';
const path        = '/compare/fan-tailed-raven-vs-brown-necked-raven/';

const breadcrumbs = [
  { name: 'Home',    url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: 'Fan-tailed Raven vs Brown-necked Raven', url: path },
];

const faq = [
  { q: 'Is the neck really brown on Brown-necked Raven?', a: 'Only in certain lights. The Brown-necked Raven\'s neck and nape feathers have a brownish, dull cast compared to the glossy black of most of the body — but this is subtle and variable with lighting conditions. It is not the most useful field mark. The head-on silhouette (longer wings relative to tail) and the call are more reliable separations.' },
  { q: 'Which is larger — Fan-tailed Raven or Brown-necked Raven?', a: 'The Brown-necked Raven is notably larger, with a body length of 50–53 cm compared to the Fan-tailed Raven\'s 44–47 cm. This size difference is useful when the two are seen together or in comparison with known species. Alone, size is harder to judge.' },
  { q: 'Where do Fan-tailed Raven and Brown-necked Raven overlap?', a: 'Both species occur across North Africa, the Sahara, the Arabian Peninsula, and northeast Africa. They are broadly sympatric across much of this range. The Fan-tailed Raven tends to favour mountainous terrain and cliff faces; the Brown-necked Raven uses flatter desert and semi-desert. In areas like the Sahara and Arabian mountains, both may be found in proximity.' },
];
---

