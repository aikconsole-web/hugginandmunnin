const title       = 'Forest Raven vs Australian Raven: How to Tell Them Apart';
const description = 'Forest Raven and Australian Raven overlap in Tasmania and parts of southeast Australia. This page gives the key differences — size, call, throat hackle, wing-flicking — with a side-by-side comparison table.';
const path        = '/compare/forest-raven-vs-australian-raven/';

const breadcrumbs = [
  { name: 'Home',    url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: 'Forest Raven vs Australian Raven', url: path },
];

const faq = [
  { q: 'Which is bigger — Forest Raven or Australian Raven?', a: 'The Australian Raven is generally considered slightly larger, with a body length of about 52–53 cm compared to the Forest Raven\'s 50–53 cm. In practice the overlap in size means size alone is unreliable as a field mark — especially in Tasmania where both occur. The Australian Raven also has a heavier, deeper chest appearance.' },
  { q: 'Can you identify Forest Raven and Australian Raven by their calls?', a: 'Yes — the calls are the most reliable separation in the field. The Australian Raven has a distinctive, prolonged, wailing "aah-aah-aaaah" (the last note drawn out and descending), earning it the nickname "the wailing raven." The Forest Raven gives a deeper, shorter "korr-korr-korr" that lacks the drawn-out wail. This call difference is consistent and identifiable with practice.' },
  { q: 'Do Forest Raven and Australian Raven interbreed?', a: 'No interbreeding has been confirmed. Where the two species overlap in Tasmania and coastal Victoria, they maintain separate territories and appear to be reproductively isolated. Their ecological separation — Forest Raven preferring dense eucalypt forest and highland areas; Australian Raven preferring more open woodland and agricultural land — also helps limit contact.' },
];
