---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Raven vs Carrion Crow — UK and European Field Guide';
const description = 'How to tell a Common Raven from a Carrion Crow in the UK and Europe: tail shape, size, bill, voice, hackles, and habitat. Sourced measurements for reliable field ID.';
const path        = '/compare/raven-vs-carrion-crow/';

const breadcrumbs = [
  { name: 'Home',    url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: 'Raven vs Carrion Crow', url: path },
];

const faq = [
  { q: 'How do I tell a raven from a Carrion Crow in the UK?', a: 'Check the tail first: wedge-shaped on a raven, fan-shaped on a Carrion Crow. Then size: ravens are noticeably larger — roughly Buzzard-sized. Voice: ravens croak ("kronk"), Carrion Crows caw. Habitat context also helps: ravens prefer upland, wild, coastal areas; Carrion Crows are common in lowland farmland, parks, and cities.' },
  { q: 'Are ravens and Carrion Crows found in the same places in the UK?', a: 'Their ranges overlap in upland areas of Wales, Scotland, northern England, and Ireland. In lowland England, Carrion Crows are common but ravens are still expanding their range from upland strongholds. In a city or suburban area, a large black corvid is almost certainly a Carrion Crow, not a raven.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

<article class="cmp-page">
  <nav class="cmp-breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
            ? <><a href={b.url}>{b.name}</a><span aria-hidden="true"> › </span></>
            : <span aria-current="page">{b.name}</span>}
        </li>
      ))}
    </ol>
  </nav>
  <header class="cmp-header">
    <p class="cmp-pillar">Comparison · Field Guide · UK / Europe</p>
    <h1>Raven vs Carrion Crow</h1>
  </header>
  <section class="cmp-snippet" aria-label="Quick answer">
    <p><strong class="claim-science">[science]</strong> Fastest marks: <strong>tail</strong> (wedge vs fan), <strong>size</strong> (raven ~twice the weight), <strong>voice</strong> (raven croaks, crow caws). Ravens also have shaggy throat hackles and a heavier bill. In upland or coastal UK, if it soars and tumbles, it is likely a raven.</p>
  </section>

  <section class="cmp-table-section">
    <h2>Side-by-Side Measurements</h2>
    <div class="cmp-table-wrap">
      <table class="cmp-table">
        <thead>
          <tr><th>Feature</th><th>Common Raven<br/><em>Corvus corax</em></th><th>Carrion Crow<br/><em>Corvus corone</em></th></tr>
        </thead>
        <tbody>
          <tr><td>Length</td><td>56–69 cm</td><td>44–51 cm</td></tr>
          <tr><td>Wingspan</td><td>120–150 cm</td><td>93–104 cm</td></tr>
          <tr><td>Weight</td><td>689–1,625 g</td><td>370–650 g</td></tr>
          <tr class="cmp-highlight"><td><strong>Tail</strong></td><td><strong>Wedge / diamond</strong></td><td><strong>Fan / rounded</strong></td></tr>
          <tr><td>Bill</td><td>Heavy, arched, deep base</td><td>Moderate, slightly curved</td></tr>
          <tr><td>Throat</td><td>Shaggy hackles</td><td>Smooth</td></tr>
          <tr class="cmp-highlight"><td><strong>Voice</strong></td><td><strong>Deep croak "kronk"</strong></td><td><strong>Harsh "kaah/caw"</strong></td></tr>
          <tr><td>Flight</td><td>Soars; plays aerially</td><td>Direct flapping; occasional soar</td></tr>
          <tr><td>UK habitat</td><td>Upland, coast, moorland, mountain</td><td>Farmland, parks, suburbs, woodland edges</td></tr>
        </tbody>
      </table>
    </div>
    <p class="cmp-src-note">Source: Madge & Burn (1994).<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="cmp-section">
    <h2>Key Tips for UK Observers</h2>
    <ul>
      <li>If you are in upland Wales, Scotland, or coastal cliffs — ravens are very likely; look for the wedge tail and large size.</li>
      <li>If you are in a lowland English city or garden — it is almost certainly a Carrion Crow. Ravens have only recently begun breeding in lowland England again.</li>
      <li>Flight style is very helpful: ravens frequently soar on thermals and play — rolling, tumbling, chasing in pairs. Carrion Crows do not play aerially in the same way.</li>
      <li>Sound first: a deep hollow "kronk" identifies a raven at a distance before you see the tail.</li>
    </ul>
  </section>

  <section class="cmp-section">
    <h2>Related Comparisons</h2>
    <ul>
      <li><a href="/compare/raven-vs-crow/">Raven vs Crow — the full 7-mark guide</a></li>
      <li><a href="/compare/raven-vs-rook/">Raven vs Rook</a></li>
      <li><a href="/species/common-raven/">Common Raven — species profile</a></li>
    </ul>
  </section>

  <section class="cmp-faq cmp-section" aria-labelledby="faq-h2">
    <h2 id="faq-h2">Frequently Asked Questions</h2>
    {faq.map(item => (
      <details class="cmp-faq-item">
        <summary class="cmp-faq-q">{item.q}</summary>
        <p class="cmp-faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <section class="cmp-sources cmp-section" aria-labelledby="src-h2">
    <h2 id="src-h2">Sources</h2>
    <ol class="cmp-src-list">
      <li id="src-1">Madge, S. & Burn, H. (1994). <em>Crows and Jays</em>. Christopher Helm. — all measurements and field marks.</li>
    </ol>
    <p class="cmp-claim-note"><strong class="claim-science">[science]</strong> field-guide data</p>
  </section>
</article>
</BaseLayout>

<style>
  .cmp-page { max-width: 860px; margin: 0 auto; padding: 2rem 1.25rem 4rem; color: var(--iron-ink, #e8e4d8); font-family: 'Inter', sans-serif; line-height: 1.72; }
  .cmp-breadcrumb ol { display: flex; flex-wrap: wrap; gap: .25rem; list-style: none; padding: 0; margin: 0 0 2rem; font-size: .8rem; color: var(--ink-soft, #8a8070); }
  .cmp-breadcrumb a { color: var(--gold-500, #d4ae5a); text-decoration: none; }
  .cmp-pillar { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-500, #d4ae5a); margin: 0 0 .4rem; }
  .cmp-page h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 2rem; line-height: 1.1; }
  .cmp-snippet { background: rgba(212,174,90,.08); border-left: 3px solid var(--gold-500, #d4ae5a); border-radius: 0 6px 6px 0; padding: 1rem 1.25rem; margin-bottom: 2.5rem; font-size: 1.03rem; }
  .cmp-section, .cmp-table-section { margin-bottom: 2.5rem; }
  .cmp-section h2, .cmp-table-section h2 { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 600; color: #fff; margin: 0 0 .9rem; border-bottom: 1px solid rgba(212,174,90,.2); padding-bottom: .4rem; }
  .cmp-section ul { padding-left: 1.25rem; margin: 0 0 1rem; }
  .cmp-section li { margin-bottom: .5rem; font-size: .95rem; }
  .cmp-table-wrap { overflow-x: auto; }
  .cmp-table { width: 100%; border-collapse: collapse; font-size: .88rem; }
  .cmp-table th { background: rgba(212,174,90,.12); color: var(--gold-500, #d4ae5a); padding: .6rem .9rem; text-align: left; font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; }
  .cmp-table td { padding: .6rem .9rem; border-bottom: 1px solid rgba(255,255,255,.06); vertical-align: top; font-size: .9rem; }
  .cmp-table tr:last-child td { border-bottom: none; }
  .cmp-highlight td { background: rgba(212,174,90,.05); font-weight: 500; }
  .cmp-src-note { font-size: .78rem; color: var(--ink-soft, #8a8070); margin-top: .5rem; }
  .claim-science { color: #7ab9e0; font-style: normal; font-size: .78rem; }
  a[href] { color: var(--gold-500, #d4ae5a); }
  .cmp-faq-item { border-bottom: 1px solid rgba(255,255,255,.07); }
  .cmp-faq-q { cursor: pointer; padding: .9rem 0; font-size: .97rem; font-weight: 500; color: #fff; list-style: none; }
  .cmp-faq-q::before { content: '+ '; color: var(--gold-500, #d4ae5a); font-weight: 700; }
  details[open] .cmp-faq-q::before { content: '− '; }
  .cmp-faq-a { margin: 0 0 1rem; line-height: 1.7; font-size: .93rem; color: var(--ink-soft, #c8c0b0); }
  .cmp-src-list { padding-left: 1.25rem; margin: 0 0 1rem; }
  .cmp-src-list li { margin-bottom: .6rem; font-size: .82rem; color: var(--ink-soft, #8a8070); line-height: 1.6; }
  .cmp-claim-note { font-size: .78rem; color: var(--ink-soft, #605848); border-top: 1px solid rgba(255,255,255,.06); padding-top: .75rem; }
</style>
