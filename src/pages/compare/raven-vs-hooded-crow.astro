---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Raven vs Hooded Crow — Field Identification';
const description = 'How to tell a Common Raven from a Hooded Crow: the grey body, smaller size, and fan-shaped tail clinch the Hooded Crow. Sourced measurements for UK, Ireland, and Europe.';
const path        = '/compare/raven-vs-hooded-crow/';

const breadcrumbs = [
  { name: 'Home',    url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: 'Raven vs Hooded Crow', url: path },
];

const faq = [
  { q: 'Can you confuse a raven with a Hooded Crow?', a: 'At distance they may both appear as large dark birds, but up close the Hooded Crow\'s grey body and wings are unmistakeable — it is not an all-black bird. Size also differs sharply: Hooded Crows are 44–51 cm, ravens 56–69 cm. Voice clinches it: ravens croak deeply, Hooded Crows give a harsh "kaah".' },
  { q: 'Where are Hooded Crows found?', a: 'Hooded Crows (Corvus cornix) are found across Ireland, northern and western Scotland, Scandinavia, parts of central and eastern Europe, and western Asia. Where Carrion Crow and Hooded Crow ranges meet (e.g. eastern Scotland), hybrids occur. Ravens share much of this range in upland and coastal areas.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

<article class="cmp-page">
  <nav class="cmp-breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
            ? <><a href={b.url}>{b.name}</a><span aria-hidden="true"> › </span></>
            : <span aria-current="page">{b.name}</span>}
        </li>
      ))}
    </ol>
  </nav>
  <header class="cmp-header">
    <p class="cmp-pillar">Comparison · Field Guide · UK / Ireland / Europe</p>
    <h1>Raven vs Hooded Crow</h1>
  </header>
  <section class="cmp-snippet" aria-label="Quick answer">
    <p><strong class="claim-science">[science]</strong> The Hooded Crow is <strong>not all-black</strong> — its body and wings are grey, making it instantly distinguishable from the all-black raven at any range. Ravens are also much larger (56–69 cm vs 44–51 cm) with a wedge-shaped tail and heavier bill. Voice: ravens croak, Hooded Crows call a harsh "kaah".</p>
  </section>

  <section class="cmp-table-section">
    <h2>Side-by-Side</h2>
    <div class="cmp-table-wrap">
      <table class="cmp-table">
        <thead>
          <tr><th>Feature</th><th>Common Raven<br/><em>Corvus corax</em></th><th>Hooded Crow<br/><em>Corvus cornix</em></th></tr>
        </thead>
        <tbody>
          <tr><td>Length</td><td>56–69 cm</td><td>44–51 cm</td></tr>
          <tr><td>Wingspan</td><td>120–150 cm</td><td>93–104 cm</td></tr>
          <tr><td>Weight</td><td>689–1,625 g</td><td>370–650 g</td></tr>
          <tr class="cmp-highlight"><td><strong>Plumage</strong></td><td><strong>Entirely black</strong></td><td><strong>Black head/wings/tail; grey body</strong></td></tr>
          <tr class="cmp-highlight"><td><strong>Tail shape</strong></td><td><strong>Wedge / diamond</strong></td><td><strong>Rounded / fan</strong></td></tr>
          <tr><td>Bill</td><td>Heavy, arched, deep base</td><td>Moderate, slightly curved</td></tr>
          <tr><td>Throat hackles</td><td>Shaggy, pointed</td><td>Smooth</td></tr>
          <tr class="cmp-highlight"><td><strong>Voice</strong></td><td><strong>Deep croak "kronk"</strong></td><td><strong>Harsh "kaah"</strong></td></tr>
          <tr><td>Flight</td><td>Soars; plays aerially</td><td>Direct flapping; occasional glide</td></tr>
          <tr><td>UK/Ireland range</td><td>Upland Wales, Scotland, N England, coasts; Ireland</td><td>Ireland, N &amp; W Scotland; absent most of England</td></tr>
        </tbody>
      </table>
    </div>
    <p class="cmp-src-note">Source: Madge &amp; Burn (1994).<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="cmp-section">
    <h2>Key Identification Points</h2>
    <ul>
      <li><strong>Plumage first:</strong> Any crow-like bird with a grey body is a Hooded Crow, not a raven. Ravens have no grey anywhere.</li>
      <li><strong>Size:</strong> Ravens are substantially larger — roughly Buzzard-sized. A Hooded Crow is closer to a Carrion Crow in bulk.</li>
      <li><strong>Tail:</strong> Ravens show a distinctive wedge or diamond tail in flight; Hooded Crows have a rounded, fan-shaped tail like other crows.</li>
      <li><strong>Hackles:</strong> At close range, the raven's shaggy, lanceolate throat feathers are visible and are absent on Hooded Crows.</li>
      <li><strong>Flight style:</strong> Ravens frequently soar and perform aerial play; Hooded Crows rarely soar for extended periods.</li>
    </ul>
  </section>

  <section class="cmp-section">
    <h2>Range Overlap in the UK and Ireland</h2>
    <p>Hooded Crows breed across Ireland, the Isle of Man, and in Scotland north and west of the Great Glen. Ravens breed widely in upland and coastal Scotland, Wales, northern England, and throughout Ireland. In Ireland and Highland Scotland, both species can be encountered in the same landscape — but plumage removes any confusion.</p>
    <p>In eastern Scotland (the hybrid zone), Hooded Crows and Carrion Crows interbreed and produce birds with intermediate plumage — this does not affect raven identification since both parent species and hybrids remain smaller, with rounded tails and different calls.<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="cmp-section">
    <h2>Related Comparisons</h2>
    <ul>
      <li><a href="/compare/raven-vs-crow/">Raven vs Crow — the full 7-mark guide</a></li>
      <li><a href="/compare/raven-vs-carrion-crow/">Raven vs Carrion Crow</a></li>
      <li><a href="/compare/raven-vs-rook/">Raven vs Rook</a></li>
      <li><a href="/species/common-raven/">Common Raven — species profile</a></li>
    </ul>
  </section>

  <section class="cmp-faq cmp-section" aria-labelledby="faq-h2">
    <h2 id="faq-h2">Frequently Asked Questions</h2>
    {faq.map(item => (
      <details class="cmp-faq-item">
        <summary class="cmp-faq-q">{item.q}</summary>
        <p class="cmp-faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <section class="cmp-sources cmp-section" aria-labelledby="src-h2">
    <h2 id="src-h2">Sources</h2>
    <ol class="cmp-src-list">
      <li id="src-1">Madge, S. &amp; Burn, H. (1994). <em>Crows and Jays</em>. Christopher Helm. — all measurements, field marks, and range data.</li>
    </ol>
    <p class="cmp-claim-note"><strong class="claim-science">[science]</strong> field-guide data</p>
  </section>
</article>
</BaseLayout>

<style>
  .cmp-page { max-width: 860px; margin: 0 auto; padding: 2rem 1.25rem 4rem; color: var(--iron-ink, #e8e4d8); font-family: 'Inter', sans-serif; line-height: 1.72; }
