 * Secondary: types of ravens compared, raven species differences, corvus raven identification
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Raven Species Comparison: How Do All 8 Raven Species Differ?';
const description = 'Eight species in the genus Corvus are called ravens, ranging from the familiar Common Raven to the little-known Somali Crow. This page compares all eight by size, range, bill shape, habitat, and key identification features.';
const path        = '/compare/raven-vs-raven-species/';

const breadcrumbs = [
  { name: 'Home',    url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: 'Raven Species Comparison', url: path },
];

const faq = [
  { q: 'How many species of raven are there?', a: 'Eight species in the genus Corvus are conventionally called ravens: the Common Raven (Corvus corax), Thick-billed Raven (C. crassirostris), White-necked Raven (C. albicollis), Chihuahuan Raven (C. cryptoleucus), Brown-necked Raven (C. ruficollis), Fan-tailed Raven (C. rhipidurus), Australian Raven (C. coronoides), and Forest Raven (C. tasmanicus). Some taxonomic authorities also include the Little Raven (C. mellori) as a ninth species; others treat Somali Crow (C. edithae) separately. The classification is not universally agreed, with some sources recognising more or fewer species.' },
  { q: 'What is the largest raven species?', a: 'The Common Raven (Corvus corax) is the largest raven and the largest passerine bird in the world, reaching 69 cm length and 1,600 g in large northern males. The Thick-billed Raven (C. crassirostris) of the Ethiopian highlands is a close second in bulk, with a massive bill that may exceed the Common Raven in bill volume. The smallest "raven" species are the Fan-tailed Raven and Brown-necked Raven of Africa and the Middle East, which overlap with large crows in size.' },
  { q: 'What is the rarest raven species?', a: 'The Somali Crow (Corvus edithae, also called Dwarf Raven) has the most restricted range of any raven species — endemic to the Horn of Africa (Somalia, eastern Ethiopia, Djibouti) and very poorly known. The Forest Raven (Corvus tasmanicus) is restricted to Tasmania and small parts of south-eastern Australia and is the rarest of the Australian ravens. The Thick-billed Raven, while locally common in the Ethiopian highlands, has an extremely limited global range.' },
];
