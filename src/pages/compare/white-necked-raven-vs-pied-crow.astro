import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'White-necked Raven vs Pied Crow: How to Tell Them Apart';
const description = 'White-necked Raven and Pied Crow overlap in eastern and southern Africa and both show white on black. The neck patch vs chest band and body size immediately separate them. Full comparison with table.';
const path        = '/compare/white-necked-raven-vs-pied-crow/';

const breadcrumbs = [
  { name: 'Home',    url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: 'White-necked Raven vs Pied Crow', url: path },
];

const faq = [
  { q: 'Which is bigger — White-necked Raven or Pied Crow?', a: 'The White-necked Raven is notably larger. Body length approximately 50–54 cm and weight 500–800 g, compared to the Pied Crow\'s body length of about 46–52 cm. The difference in bulk is more significant than the overlap in length suggests — the White-necked Raven is a heavier-bodied bird with a much more powerful bill.' },
  { q: 'Are White-necked Raven and Pied Crow in the same genus?', a: 'Yes. Both belong to the genus Corvus (family Corvidae). The White-necked Raven is Corvus albicollis; the Pied Crow is Corvus albus. Despite their common names, both are corvids. The Pied Crow is classified as a crow rather than a raven, based primarily on its smaller size and its different distribution of white plumage.' },
  { q: 'Where do White-necked Raven and Pied Crow overlap?', a: 'Both species occur across eastern and southern Africa, particularly in highland and mountain areas. The White-necked Raven is primarily associated with mountains and rocky terrain; the Pied Crow is more widespread across open lowlands, farmland, and urban areas. In highland areas of Kenya, Tanzania, Ethiopia, and South Africa, both species can be found in proximity.' },
];
---

