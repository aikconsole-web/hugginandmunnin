---
import BaseLayout from '../layouts/BaseLayout.astro';
import SvgDefs from '../components/SvgDefs.astro';
import HeroSection from '../components/HeroSection.astro';
import MarqueeSection from '../components/MarqueeSection.astro';
import StatsSection from '../components/StatsSection.astro';
import SpeciesAtlas from '../components/SpeciesAtlas.astro';
import LoreSection from '../components/LoreSection.astro';
import MindSection from '../components/MindSection.astro';
import FieldGuide from '../components/FieldGuide.astro';
import LibrarySection from '../components/LibrarySection.astro';
import { SITE } from '../config/site';
import { SPECIES } from '../data/species';

const title       = `${SITE.name} — ${SITE.tagline}`;
const description = SITE.description;

// Serialise species for the client-side atlas script
const speciesJson = JSON.stringify(SPECIES);
---

<BaseLayout title={title} description={description} path="/">

  <main id="main">

    <!-- Hidden SVG defs (gradients + moon symbol) used by all raven SVGs -->
    <SvgDefs/>

    <HeroSection/>
    <MarqueeSection/>
    <StatsSection/>
    <SpeciesAtlas/>
    <LoreSection/>
    <MindSection/>
    <FieldGuide/>
    <LibrarySection/>

    <!-- Site navigation hub -->
    <section id="nav-hub" aria-label="Site navigation" style="background:#080c12;border-top:1px solid rgba(212,174,90,.18)">
      <div style="max-width:1280px;margin:0 auto;padding:80px 32px 72px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:48px">

        <!-- Species -->
        <div>
          <p style="margin:0 0 18px;font-size:11px;letter-spacing:.35em;text-transform:uppercase;color:#d4ae5a">Species</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px">
            <li><a href="/species/" style="color:#c9ced8;text-decoration:none;font-size:14px">All Ten Species</a></li>
            <li><a href="/species/common-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Common Raven</a></li>
            <li><a href="/species/thick-billed-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Thick-billed Raven</a></li>
            <li><a href="/species/white-necked-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">White-necked Raven</a></li>
            <li><a href="/species/chihuahuan-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Chihuahuan Raven</a></li>
            <li><a href="/species/australian-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Australian Raven</a></li>
            <li><a href="/species/forest-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Forest Raven</a></li>
            <li><a href="/species/little-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Little Raven</a></li>
            <li><a href="/species/brown-necked-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Brown-necked Raven</a></li>
            <li><a href="/species/fan-tailed-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Fan-tailed Raven</a></li>
            <li><a href="/species/somali-crow/" style="color:#c9ced8;text-decoration:none;font-size:14px">Somali Crow</a></li>
          </ul>
        </div>

        <!-- Lore -->
        <div>
          <p style="margin:0 0 18px;font-size:11px;letter-spacing:.35em;text-transform:uppercase;color:#d4ae5a">Lore</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px">
            <li><a href="/lore/norse/" style="color:#c9ced8;text-decoration:none;font-size:14px">Norse Lore</a></li>
            <li><a href="/lore/norse/huginn-and-muninn/" style="color:#c9ced8;text-decoration:none;font-size:14px">Huginn and Muninn</a></li>
            <li><a href="/lore/norse/odin-the-raven-god/" style="color:#c9ced8;text-decoration:none;font-size:14px">Odin the Raven-God</a></li>
            <li><a href="/lore/norse/raven-banners/" style="color:#c9ced8;text-decoration:none;font-size:14px">Raven Banners</a></li>
            <li><a href="/lore/world/" style="color:#c9ced8;text-decoration:none;font-size:14px">World Lore</a></li>
            <li><a href="/lore/world/edgar-allan-poe-the-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Poe's The Raven</a></li>
            <li><a href="/lore/world/raven-symbolism/" style="color:#c9ced8;text-decoration:none;font-size:14px">Raven Symbolism</a></li>
            <li><a href="/lore/world/noah-and-the-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Noah and the Raven</a></li>
            <li><a href="/lore/world/apollo-and-the-raven/" style="color:#c9ced8;text-decoration:none;font-size:14px">Apollo and the Raven</a></li>
            <li><a href="/lore/world/raven-in-celtic-mythology/" style="color:#c9ced8;text-decoration:none;font-size:14px">Celtic Mythology</a></li>
            <li><a href="/lore/world/ravens-in-japanese-mythology/" style="color:#c9ced8;text-decoration:none;font-size:14px">Japanese Mythology</a></li>
          </ul>
        </div>

        <!-- Behaviour & Science -->
        <div>
          <p style="margin:0 0 18px;font-size:11px;letter-spacing:.35em;text-transform:uppercase;color:#d4ae5a">Behaviour &amp; Science</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px">
            <li><a href="/behaviour/" style="color:#c9ced8;text-decoration:none;font-size:14px">All Behaviour Chapters</a></li>
            <li><a href="/behaviour/raven-intelligence/" style="color:#c9ced8;text-decoration:none;font-size:14px">Intelligence</a></li>
            <li><a href="/behaviour/raven-food-caching/" style="color:#c9ced8;text-decoration:none;font-size:14px">Food Caching</a></li>
            <li><a href="/behaviour/raven-social-structure/" style="color:#c9ced8;text-decoration:none;font-size:14px">Social Structure</a></li>
            <li><a href="/behaviour/raven-vocalisation/" style="color:#c9ced8;text-decoration:none;font-size:14px">Vocalisation</a></li>
            <li><a href="/behaviour/raven-play/" style="color:#c9ced8;text-decoration:none;font-size:14px">Play</a></li>
            <li><a href="/behaviour/raven-nesting/" style="color:#c9ced8;text-decoration:none;font-size:14px">Nesting</a></li>
            <li><a href="/behaviour/raven-and-wolves/" style="color:#c9ced8;text-decoration:none;font-size:14px">Ravens and Wolves</a></li>
            <li><a href="/behaviour/raven-cognition-theory-of-mind/" style="color:#c9ced8;text-decoration:none;font-size:14px">Theory of Mind</a></li>
            <li><a href="/behaviour/raven-migration/" style="color:#c9ced8;text-decoration:none;font-size:14px">Migration</a></li>
          </ul>
        </div>

        <!-- Compare & Q&A -->
        <div>
          <p style="margin:0 0 18px;font-size:11px;letter-spacing:.35em;text-transform:uppercase;color:#d4ae5a">Compare &amp; Questions</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px">
            <li><a href="/compare/" style="color:#c9ced8;text-decoration:none;font-size:14px">All Comparisons</a></li>
            <li><a href="/compare/raven-vs-crow/" style="color:#c9ced8;text-decoration:none;font-size:14px">Raven vs Crow</a></li>
            <li><a href="/compare/common-raven-vs-american-crow/" style="color:#c9ced8;text-decoration:none;font-size:14px">Common Raven vs American Crow</a></li>
            <li><a href="/compare/raven-vs-rook/" style="color:#c9ced8;text-decoration:none;font-size:14px">Raven vs Rook</a></li>
            <li><a href="/compare/raven-vs-magpie/" style="color:#c9ced8;text-decoration:none;font-size:14px">Raven vs Magpie</a></li>
            <li><a href="/questions/" style="color:#c9ced8;text-decoration:none;font-size:14px">All Questions</a></li>
            <li><a href="/questions/how-smart-are-ravens/" style="color:#c9ced8;text-decoration:none;font-size:14px">How Smart Are Ravens?</a></li>
            <li><a href="/questions/how-long-do-ravens-live/" style="color:#c9ced8;text-decoration:none;font-size:14px">How Long Do Ravens Live?</a></li>
            <li><a href="/questions/what-do-ravens-eat/" style="color:#c9ced8;text-decoration:none;font-size:14px">What Do Ravens Eat?</a></li>
            <li><a href="/myths/" style="color:#c9ced8;text-decoration:none;font-size:14px">Myths Fact-checked</a></li>
          </ul>
        </div>

      </div>
    </section>

    <!-- Footer -->
    <footer style="border-top:1px solid rgba(212,174,90,.25);background:#080a0e">
      <div style="max-width:1280px;margin:0 auto;padding:64px 32px 40px;display:flex;flex-wrap:wrap;gap:40px;justify-content:space-between">
        <div style="flex:1 1 320px;min-width:0">
          <p style="margin:0;display:flex;align-items:center;gap:12px">
            <span class="rune" style="font-size:28px;color:#d4ae5a">ᚺ</span>
            <span class="serif" style="font-size:28px;font-weight:700;letter-spacing:.28em;color:#ecebe6">HRAFN</span>
          </p>
          <p class="serif" style="margin:16px 0 0;max-width:380px;font-size:19px;line-height:1.5;font-style:italic;color:#a3abb8">
            A library of ravens — their species, their stories and their minds.
          </p>
        </div>
        <nav aria-label="Footer" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 48px">
          <a href="/species/"   style="padding:10px 0;text-decoration:none;color:#c9ced8;font-size:14px">Species Atlas</a>
          <a href="/lore/norse/" style="padding:10px 0;text-decoration:none;color:#c9ced8;font-size:14px">Norse Lore</a>
          <a href="/behaviour/" style="padding:10px 0;text-decoration:none;color:#c9ced8;font-size:14px">Mind &amp; Behaviour</a>
          <a href="/compare/"   style="padding:10px 0;text-decoration:none;color:#c9ced8;font-size:14px">Field Guide</a>
          <a href="/questions/" style="padding:10px 0;text-decoration:none;color:#c9ced8;font-size:14px">Questions</a>
          <a href="/myths/"     style="padding:10px 0;text-decoration:none;color:#c9ced8;font-size:14px">Myths</a>
        </nav>
      </div>
      <div style="max-width:1280px;margin:0 auto;padding:22px 32px 34px;border-top:1px solid rgba(232,230,225,.08);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:13px;color:#8f97a6">
        <span>© 2026 Hrafn — The Raven Library. General natural-history and cultural information; not a substitute for academic study or wildlife-care advice.</span>
        <span class="rune" style="letter-spacing:.4em;color:#6f6750">ᚺᚱᚨᚠᚾ</span>
      </div>
    </footer>

  </main>

</BaseLayout>

<!-- Inject species data, then run the atlas + hero script -->
<script define:vars={{ speciesJson }}>
  window.HRAFN_SPECIES = JSON.parse(speciesJson);
</script>
<script>
  import '../scripts/hrafn.ts';
</script>
