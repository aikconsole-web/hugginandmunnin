import BaseLayout from '../../../layouts/BaseLayout.astro';

const title       = 'Huginn and Muninn — Odin\'s Ravens in Norse Mythology';
const description = 'Huginn ("Thought") and Muninn ("Memory") are Odin\'s two ravens in Norse mythology. Sourced directly from the Eddas — Grímnismál stanza 20 and Gylfaginning — with Old Norse text and scholarly commentary.';
const path        = '/lore/norse/huginn-and-muninn/';

const breadcrumbs = [
  { name: 'Home',       url: '/' },
  { name: 'Norse Lore', url: '/lore/norse/' },
  { name: 'Huginn and Muninn', url: path },
];

const faq = [
  { q: 'What are Odin\'s ravens called?', a: 'Odin\'s two ravens are called Huginn (Old Norse: *Huginn*, meaning "Thought") and Muninn (Old Norse: *Muninn*, meaning "Memory" or "Mind"). Their names are confirmed in the Eddic poem Grímnismál, stanza 20.' },
  { q: 'What do Huginn and Muninn do?', a: 'Each dawn, Huginn and Muninn fly across the nine worlds, observe everything that happens, and return at breakfast to perch on Odin\'s shoulders and whisper what they have seen and heard. This is described in Grímnismál stanza 20 and Gylfaginning chapter 38.' },
  { q: 'What do Huginn and Muninn mean?', a: 'Huginn derives from Old Norse *hugr* ("thought", "mind", "intention"). Muninn is typically translated as "memory" or "mind", from *munr* or *muna* ("to remember"). Some scholars, including Anthony Faulkes, translate Muninn as "desire" or "longing".' },
  { q: 'Why did Odin worry about his ravens?', a: 'In Grímnismál stanza 20, Odin says he fears that Huginn may not return, but he fears for Muninn more. Scholars interpret this as an anxiety about memory, reason, and sanity — the qualities Odin most depends on for his power.' },
  { q: 'Are Huginn and Muninn Common Ravens?', a: 'The Eddas do not name the species. Modern ornithologists and scholars universally assume the birds are Common Ravens (Corvus corax), the species native to Scandinavia, Iceland, and the wider Norse world.' },
];
---

