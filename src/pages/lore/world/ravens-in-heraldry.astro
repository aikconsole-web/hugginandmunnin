const breadcrumbs = [
  { name: 'Home',         url: '/' },
  { name: 'Lore',         url: '/lore/world/' },
  { name: 'Ravens in Heraldry', url: path },
];

const faq = [
  { q: 'What do ravens symbolise in heraldry?', a: 'In heraldry, ravens typically symbolise warriors, battle prowess, and divine favour in the Norse tradition, or represent specific family and territorial associations in Welsh, Irish, and Cornish heraldry. The raven was associated with Odin and Viking martial culture; the raven banner (hrafnsmerki) was a Norse war standard. In later heraldry (from the 12th century onward), ravens appear as charges in family arms, often deriving from Norse ancestry or territorial associations with places named for ravens.' },
];
---

