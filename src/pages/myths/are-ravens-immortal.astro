const path        = '/myths/are-ravens-immortal/';

const breadcrumbs = [
  { name: 'Home',  url: '/' },
  { name: 'Myths', url: '/myths/' },
  { name: 'Are Ravens Immortal?', url: path },
];

const faq = [
  { q: 'How long do ravens live?', a: 'Wild Common Ravens have documented lifespans of 10–15 years on average, with the oldest wild-banded individuals reaching 21–23 years. Captive ravens can live considerably longer: Odin, a raven at the Tower of London, reportedly lived to around 44 years, though documentation of extreme captive ages is not always rigorous. The raven\'s lifespan is long for a bird of its size, but falls far short of immortality.' },
  { q: 'Why do people think ravens are immortal?', a: 'The belief in raven immortality or extreme longevity likely derives from several sources: the raven\'s association with gods (Odin\'s ravens Huginn and Muninn are supernatural beings, not ordinary birds); the longevity of well-known captive ravens at sites like the Tower of London; and the raven\'s consistent presence in landscapes across human generations, making it seem as if "the raven" is always there — not distinguishing between individual birds. In Welsh tradition, Bran (whose name means raven) is a giant king with supernatural resilience — another source of raven-immortality associations.' },
  { q: 'What is the oldest known raven?', a: 'The longest reliably documented lifespan for a wild Common Raven from ringing data is approximately 21–23 years. Captive ravens can live longer: anecdotal records from the Tower of London and zoo collections suggest 30–40+ years in some cases, though early records lacked rigorous documentation. The popular claim of a 44-year-old Tower raven is frequently cited but difficult to verify independently. Scientifically documented maximum lifespans place ravens well below the extreme longevity attributed to them in myth.' },
];
