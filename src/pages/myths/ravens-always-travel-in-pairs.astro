---
/**
 * Myths — Ravens always travel in pairs
 * MYTH·17
 * Primary keyword: do ravens travel in pairs
 * Secondary: raven pair behaviour, do ravens stay together, raven social group
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Myth: Ravens Always Travel in Pairs';
const description = 'Ravens do form lasting pair bonds — but they don\'t always travel as pairs. Non-breeding ravens gather in large flocks and roosts. This page examines when and how ravens travel alone, in pairs, or in groups.';
const path        = '/myths/ravens-always-travel-in-pairs/';

const breadcrumbs = [
  { name: 'Home',  url: '/' },
  { name: 'Myths', url: '/myths/' },
  { name: 'Ravens Always Travel in Pairs', url: path },
];

const faq = [
  { q: 'Do ravens always fly in pairs?', a: 'No. While breeding ravens are bonded in pairs and often seen together on and near their territory, non-breeding ravens (young birds aged 1–3 years, plus unpaired adults) congregate in large groups. These non-breeding flocks can number dozens to hundreds of birds and travel together to food sources. Even mated pairs may separate for periods outside the breeding season. The image of ravens as invariably in pairs is based on observations of territorial breeding birds.' },
  { q: 'When do ravens travel in groups?', a: 'Ravens are most likely to be seen in groups when: (1) a large food source has been discovered — large carcasses attract many birds including non-breeding flocks; (2) at communal night roosts, which can contain hundreds of birds in winter; (3) during the non-breeding season, when young ravens in their first 2–3 years live nomadically in loose flocks; (4) during the raven gathering and selection process, when young birds prospect for mates in loose aggregations.' },
  { q: 'Are ravens more social than crows?', a: 'It depends on how "social" is defined. American Crows and Carrion Crows form very large winter roosts (hundreds of thousands of birds) that may exceed raven roost sizes. But ravens show more complex social relationships within their groups — longer pair bonds, more sophisticated affiliative behaviours (allopreening, food sharing, consolation), and a more structured social hierarchy in non-breeding flocks. Ravens\' social intelligence (theory of mind, deception detection) suggests their social relationships are more cognitively complex than crow social bonds, even if crow groups are numerically larger.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

