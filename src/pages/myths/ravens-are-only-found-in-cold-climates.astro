---
/**
 * Myths — Ravens are only found in cold climates
 * MYTH·15
 * Primary keyword: do ravens live in hot climates
 * Secondary: ravens desert, ravens tropical, raven climate range
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Myth: Ravens Only Live in Cold Climates';
const description = 'Ravens are strongly associated with cold, dark landscapes — but the Common Raven ranges from Arctic tundra to Saharan desert, tropical Arabian mountains, and the hot Sonoran Desert. This page examines where ravens actually live.';
const path        = '/myths/ravens-are-only-found-in-cold-climates/';

const breadcrumbs = [
  { name: 'Home',  url: '/' },
  { name: 'Myths', url: '/myths/' },
  { name: 'Ravens Are Only Found in Cold Climates', url: path },
];

const faq = [
  { q: 'Can ravens survive hot weather?', a: 'Yes. The Common Raven (Corvus corax) is a year-round resident of some of the hottest environments on Earth — including the Sonoran Desert of Arizona (summer temperatures exceeding 45°C/113°F), the Sahara, and the arid interior of the Arabian Peninsula. Ravens manage heat through behavioural thermoregulation: shifting activity to early morning and evening, resting in shade during midday, and using gular flutter (throat vibration) to cool the brain. Their black plumage is a disadvantage in intense sun, but behavioural avoidance compensates.' },
  { q: 'Where do ravens live in the world?', a: 'The Common Raven has one of the widest distributions of any bird species: from the Arctic coast of Alaska, Canada, and Siberia south to Nicaragua in Central America; across Europe and North Africa; through the Middle East and Central Asia to the Himalayas, Korea, and Japan. It occupies biomes from Arctic tundra, boreal forest, and temperate forests to Mediterranean scrub, desert, and high-altitude grasslands above 5,000 m. No other raven species has this range; other species are more locally distributed in Africa and Australia.' },
  { q: 'Are ravens more common in cold places?', a: 'Ravens reach their highest population densities in areas with abundant carrion and suitable nesting sites — which often correlates with mountainous, boreal, or northern environments. But ravens are also numerous in desert regions of the American Southwest, the Middle East, and North Africa. The association of ravens with cold, dark environments is partly a product of their strong presence in Norse, Celtic, and northern folklore traditions — cultures that encountered ravens in northern Europe.' },
];
---

