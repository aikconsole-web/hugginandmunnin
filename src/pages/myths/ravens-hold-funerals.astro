---
/**
 * Myth vs Fact — Ravens hold funerals
 * MYTH·09
 * Primary keyword: do ravens hold funerals
 * Secondary: ravens gather around dead ravens, raven funeral behaviour
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Myth: "Ravens Hold Funerals for Their Dead"';
const description = 'Ravens do gather around dead conspecifics, but whether this constitutes a "funeral" is contested. The best-studied evidence comes from American Crows, not ravens. Verdict: Partly True — with important caveats.';
const path        = '/myths/ravens-hold-funerals/';

const breadcrumbs = [
  { name: 'Home',   url: '/' },
  { name: 'Myths',  url: '/myths/' },
  { name: 'Ravens Hold Funerals', url: path },
];

const faq = [
  { q: 'Have "raven funerals" been studied scientifically?', a: 'The most rigorous research on corvid gathering behaviour around the dead was conducted by Kaeli Swift and John Marzluff (2015) using American Crows, not ravens. Crows were shown to gather around dead conspecifics, produce alarm calls, and subsequently avoid the area — behaviour Swift interprets as information-gathering about danger, not mourning. No equivalent controlled experiment has been published specifically for Common Ravens.' },
  { q: 'Do ravens show any signs of mourning?', a: 'Anecdotal accounts and keeper observations describe ravens showing what looks like distressed behaviour after a companion\'s death — reduced activity, increased vocalisations near the body. Whether this constitutes "mourning" in a subjective sense is unknown. The behaviour is consistent with both emotional response and information-gathering about a novel, potentially dangerous situation.' },
  { q: 'Which birds are known to gather around their dead?', a: 'Gathering around dead conspecifics has been documented in American Crows (Swift & Marzluff, 2015), Western Scrub-Jays, Magpies, and several species of parrot. In each case, the interpretation ranges from information-gathering (learning that a location is dangerous) to social response to loss. The term "funeral" is a human metaphor applied to these gatherings.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

