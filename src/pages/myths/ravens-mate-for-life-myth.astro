const title       = 'Do Ravens Really Mate for Life? Fact Check';
const description = 'Ravens do typically form long-term pair bonds lasting many years, but "mate for life" oversimplifies. Divorce occurs; widowed birds re-pair. What the evidence shows.';
const path        = '/myths/ravens-mate-for-life-myth/';

const breadcrumbs = [
  { name: 'Home',  url: '/' },
  { name: 'Myths', url: '/myths/' },
  { name: 'Ravens Mate for Life', url: path },
];

const faq = [
  { q: 'Do ravens mate for life?', a: 'Ravens typically form long-term pair bonds that last for many years — often until a partner dies. This is true. However, "mate for life" is an oversimplification: divorce (voluntary pair dissolution while both partners survive) has been documented in ravens, and widowed birds re-pair with new mates. The long-term pair bond is real and behaviorally significant, but it is not unconditional or permanent in all cases.' },
];
---

