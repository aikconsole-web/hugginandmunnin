/**
 * Myths — Ravens only eat carrion
 * MYTH·21
 * Primary keyword: do ravens only eat carrion
 * Secondary: what do ravens eat, ravens omnivore, raven diet myth
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Do Ravens Only Eat Carrion? The Omnivore Myth Examined';
const description = 'Ravens are strongly associated with carrion and death, but they are generalist omnivores — their diet spans berries, insects, eggs, small mammals, plant matter, and human food waste. This page examines what ravens actually eat and why the carrion-only myth persists.';
const path        = '/myths/ravens-only-eat-carrion/';

const breadcrumbs = [
  { name: 'Home',   url: '/' },
  { name: 'Myths',  url: '/myths/' },
  { name: 'Ravens Only Eat Carrion', url: path },
];

const faq = [
  { q: 'Do ravens only eat dead animals?', a: 'No. Ravens are generalist omnivores — carrion is an important food source but represents only part of their actual diet. Studies of raven diet from stomach contents, pellet analysis, and direct observation document consumption of: invertebrates (beetles, grasshoppers, earthworms), small vertebrates (voles, mice, lizards), eggs and nestlings of other birds, berries and other plant material, grain, human food waste, and large carrion. The relative contribution of each food type varies seasonally and geographically — carrion is especially important in winter and in upland/arctic habitats where invertebrate prey is scarce.' },
  { q: 'Are ravens herbivores?', a: 'Ravens are not herbivores — they are omnivores that consume both animal and plant material, with animal matter (invertebrates, vertebrate prey, eggs, carrion) making up the majority of their diet in most habitats. However, plant foods can form a significant fraction of diet seasonally: berries (rowan, blueberry, crowberry) are consumed heavily in late summer and autumn in upland habitats; grain is consumed from agricultural fields; and plant material is documented in pellets and stomach contents from various populations. Ravens are best described as opportunistic omnivores — they eat whatever is available and profitable.' },
  { q: 'Why are ravens associated with carrion and death?', a: 'Ravens\' cultural association with death derives from their real behaviour: they are attracted to large carcasses, they follow hunters, soldiers, and herders, and they appear wherever dying animals are present. In pre-modern Europe, ravens appeared at battlefields, gibbets, and slaughterhouses — prominent locations that made their carrion-feeding highly visible and culturally memorable. This conspicuous association with death became embedded in literature, heraldry, and folklore, creating an impression that carrion is their primary food — when in fact it is one of several food categories that ravens exploit opportunistically. The death association is real but the exclusivity of the carrion diet is myth.' },
];

const verdict = 'false';
---

