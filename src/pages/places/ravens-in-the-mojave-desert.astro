const path        = '/places/ravens-in-the-mojave-desert/';

const breadcrumbs = [
  { name: 'Home',   url: '/' },
  { name: 'Places', url: '/places/' },
  { name: 'Ravens in the Mojave Desert', url: path },
];

const faq = [
  { q: 'Are ravens native to the Mojave Desert?', a: 'Common Ravens are native to the Mojave Desert and have been year-round residents of the region for millennia. However, their population density in the Mojave has increased dramatically in the 20th and 21st centuries — driven by the expansion of human infrastructure providing food and water in a landscape where both are naturally scarce. Pre-settlement raven densities in the Mojave were significantly lower; the current elevated population is a human-subsidised artifact rather than a natural baseline.' },
  { q: 'Do ravens eat desert tortoises?', a: 'Ravens do not regularly prey on adult desert tortoises (Gopherus agassizii), which are protected by their shell. However, juvenile tortoises and tortoise eggs are vulnerable to raven predation. Studies in the Mojave have documented ravens as a significant source of mortality for juvenile tortoises: ravens can carry off young tortoises and crack the shells of juveniles up to approximately 60mm in length. In areas with elevated raven densities near human infrastructure, tortoise juvenile survival is significantly lower than in areas with lower raven densities. This predation pressure is a documented conservation concern for the Mojave desert tortoise, which is federally listed as threatened.' },
  { q: 'How is the raven-tortoise problem being managed?', a: 'The US Bureau of Land Management (BLM) and other agencies have implemented raven management programmes in the Mojave to reduce predation pressure on desert tortoises. Management strategies have included: targeted lethal control (permitted removal of ravens near tortoise critical habitat); removal of human-provided food and water sources (closing or modifying rest stops, refuse sites) that subsidise elevated raven populations; nest removal at utility infrastructure; and public education to reduce intentional or inadvertent raven feeding near protected tortoise areas. These measures are controversial — ravens are protected under the Migratory Bird Treaty Act and are native wildlife — and their effectiveness in reducing tortoise predation is debated.' },
];
