const title       = 'Ravens in the Sonoran Desert: Ecology and Desert Adaptation';
const description = 'The Common Raven is a year-round resident of the Sonoran Desert — one of the hottest and most arid environments in North America. This page examines how ravens survive and thrive in the desert, their relationships with other desert species, and their ecological role in this ecosystem.';
const path        = '/places/ravens-in-the-sonoran-desert/';

const breadcrumbs = [
  { name: 'Home',   url: '/' },
  { name: 'Places', url: '/places/' },
  { name: 'Ravens in the Sonoran Desert', url: path },
];

const faq = [
  { q: 'Are ravens common in the Sonoran Desert?', a: 'Yes. The Common Raven (Corvus corax) is a year-round resident throughout the Sonoran Desert — in Arizona, southern California, and the adjacent Mexican states of Sonora and Baja California. Ravens are conspicuous birds in the Sonoran Desert, particularly around human infrastructure (towns, roads, landfills), saguaro cactus habitat, rocky outcrops and cliffs, and anywhere large animal carcasses are available. They have expanded in population since the mid-20th century alongside human development.' },
  { q: 'How do ravens survive in the desert heat?', a: 'Ravens are well-adapted to desert conditions. Key behavioural and physiological strategies include: reducing activity during the hottest midday hours (shifting foraging to early morning and late afternoon); seeking shade on cliff faces and under saguaro ribs; drinking when water is available and exploiting water from food (especially fruit, cactus pads, and prey); panting (gular flutter) for evaporative cooling; and in extreme heat, raising the feathers on the head and body to allow heat dissipation. Ravens\' black plumage absorbs more radiation than pale-feathered desert birds, but their large size reduces relative surface area and they compensate behaviourally.' },
  { q: 'What do ravens eat in the Sonoran Desert?', a: 'Sonoran Desert ravens exploit a diverse food base: carrion from deer, cattle, and roadkill; invertebrates (beetles, scorpions, lizards, snakes); saguaro cactus fruit and other cactus fruits when in season; eggs and chicks of ground-nesting birds; small mammals; and human food waste from towns, landfills, and campgrounds. The saguaro cactus (Carnegiea gigantea) is a particularly important seasonal food source — ravens eat both the fruit and the insects that colonise the cactus.' },
];
