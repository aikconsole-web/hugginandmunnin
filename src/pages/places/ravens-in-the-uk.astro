const path        = '/places/ravens-in-the-uk/';

const breadcrumbs = [
  { name: 'Home',   url: '/' },
  { name: 'Places', url: '/places/' },
  { name: 'Ravens in the UK', url: path },
];

const faq = [
  { q: 'Where do ravens live in the UK?', a: 'Ravens are present throughout Wales, in upland northern England (Cumbria, North Yorkshire, the Pennines), southern Scotland, and the Scottish Highlands and islands. They have been slowly recolonising central and southern England — birds are now recorded breeding in some lowland English counties where they were absent for centuries. Ireland has a healthy raven population throughout. Coastal cliffs, upland moorland, and forestry plantation edge are typical habitats.' },
  { q: 'How many ravens are there in the UK?', a: 'The UK breeding population has been estimated at approximately 7,000–8,000 pairs as of recent surveys (RSPB/BTO data from the 2010s), with the population continuing to increase and expand its range southward and eastward. This represents a substantial recovery from the population low of the 19th and early 20th centuries, when ravens were confined to Wales and remote Scottish areas.' },
  { q: 'Are ravens protected in the UK?', a: 'Yes. Common Ravens are protected under the Wildlife and Countryside Act 1981 (and equivalent legislation in Scotland and Northern Ireland). It is illegal to intentionally kill, injure, or take wild ravens, to damage or destroy their nests while in use or being built, or to take or destroy their eggs. Limited licence-based management may be granted under specific circumstances, but general persecution is illegal.' },
];
