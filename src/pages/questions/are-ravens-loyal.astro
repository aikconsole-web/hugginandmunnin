const title       = 'Are Ravens Loyal? Pair Bonds, Alliances, and Fidelity';
const description = 'Ravens form long-term pair bonds, stable social alliances, and persistent individual relationships that look a great deal like loyalty. This page examines what the science actually shows about raven fidelity.';
const path        = '/questions/are-ravens-loyal/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'Are Ravens Loyal?', url: path },
];

const faq = [
  { q: 'Are ravens loyal to their mates?', a: 'Common Ravens form long-term, predominantly monogamous pair bonds that often persist for many years and in many cases for life. Pairs roost together, forage cooperatively, defend their territory jointly, and breed together year after year. Divorce does occur — an estimated 10–20% of pairs separate between seasons — but long-term fidelity is the norm. The pair bond is reinforced by sustained behaviours including allopreening (mutual preening), billing, shared aerial displays, and food sharing.' },
  { q: 'Are ravens loyal to humans?', a: 'Ravens raised in close contact with humans can form strong individual bonds with specific people — responding to their keeper\'s voice, following them, and showing distress at separation. Konrad Lorenz described ravens in his care that formed strong attachments to him. These attachments appear to reflect the same social bonding mechanisms ravens use with conspecifics, redirected to humans. Wild ravens do not typically bond with humans, though individuals in areas with regular human–raven contact may become familiar and tolerant.' },
  { q: 'Do ravens remember their friends?', a: 'Yes. Research by Maddalena Nava and colleagues at the Konrad Lorenz Research Station documents that ravens maintain differentiated, long-term social relationships with specific individuals — both allies and opponents. These relationships are updated and remembered over time, and ravens respond differently to allies, rivals, and strangers based on their history of interaction. This long-term individual recognition underpins what we might call social loyalty in ravens.' },
];
