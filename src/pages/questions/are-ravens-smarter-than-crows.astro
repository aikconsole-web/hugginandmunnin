import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Are Ravens Smarter Than Crows?';
const description = 'Ravens and crows are both exceptionally intelligent corvids. This page examines the evidence on each species\' cognitive strengths and whether one is definitively "smarter."';
const path        = '/questions/are-ravens-smarter-than-crows/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'Are Ravens Smarter Than Crows?', url: path },
];

const faq = [
  { q: 'Which is smarter — a raven or an American Crow?', a: 'The question cannot be given a simple answer. Ravens outperform crows in some studies (tool use, future planning, gaze following), while crows — particularly New Caledonian Crows — show more sophisticated physical problem-solving and tool manufacture. American Crows show better-documented facial recognition in controlled experiments. Intelligence is not a single dimension; each species excels in different areas that suit its ecology.' },
  { q: 'Have ravens and crows been directly compared in the same experiment?', a: 'Direct side-by-side comparisons are uncommon because the species are studied by different research groups in different countries. The Kabadayi & Osvath (2017) planning study compared ravens to great apes but not directly to crows. Cross-species comparisons are methodologically difficult — experimental design, familiarity with researchers, and social context all affect performance.' },
  { q: 'Do ravens use tools the way New Caledonian Crows do?', a: 'No. New Caledonian Crows are the most sophisticated tool users among birds — they manufacture hooks from leaves and use them to extract prey. Ravens show tool use in experiments (selecting and saving tools) but do not manufacture multi-step tools in the wild. Wild Common Raven tool use, in contrast to the crows, is rare and simple.' },
];
---

