 * Q&A — Do ravens have a favourite food?
 * Primary keyword: what is a raven's favourite food
 * Secondary: raven food preference, raven diet preferences, what do ravens prefer to eat
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'What Is a Raven\'s Favourite Food?';
const description = 'Ravens are dietary opportunists — but they do have strong food preferences, particularly for meat and carrion. This page examines raven food preferences, what they seek when given choice, and how their diet varies seasonally and regionally.';
const path        = '/questions/do-ravens-have-a-favourite-food/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'What Is a Raven\'s Favourite Food?', url: path },
];

const faq = [
  { q: 'What is a raven\'s favourite food?', a: 'Ravens show a strong preference for meat and high-fat, high-protein foods. In field observations and captive preference tests, ravens consistently favour: large carcasses (ungulate carrion — deer, elk, cattle, moose); eggs and nestlings; small mammals; and cached fat and meat stores. Among plant foods, ravens prefer energy-rich items — large seeds, nuts, and berries — over vegetation. When given choice in captive studies, ravens reliably prefer animal protein over plant food, and within animal food, prefer higher-fat items (brain, organ meat) over lean muscle meat.' },
  { q: 'Do ravens like eggs?', a: 'Yes — eggs are a highly preferred food for ravens. Ravens will travel specifically to known nesting sites of ground-nesting birds (ptarmigan, geese, shorebirds) during their breeding seasons. Raven predation on eggs and chicks of ground-nesting birds is documented as a significant source of nest failure in some Arctic and sub-Arctic habitats. Ravens locate eggs through visual search and possibly smell; they carry eggs in their bill or throat pouch to cache or consume elsewhere.' },
  { q: 'Do ravens prefer live prey or carrion?', a: 'Ravens are primarily scavengers and opportunistic predators — they strongly prefer carrion over live prey of comparable size, as it requires less energy to obtain. However, ravens do take live prey when it is easily caught: invertebrates, small rodents, bird eggs and chicks, fish stranded in shallow water. The raven\'s powerful bill can break through frozen skin and thick hide on carcasses — an advantage over many smaller scavengers. When both are available, a large carcass will typically draw ravens away from live-prey opportunities.' },
];
