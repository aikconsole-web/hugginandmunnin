const title       = 'Do Ravens Have Feelings? Raven Emotions and Empathy';
const description = 'Research on raven cognition and behaviour suggests ravens experience functional emotional states — fear, curiosity, play, apparent grief, and responses that look like empathy. This page examines the evidence carefully.';
const path        = '/questions/do-ravens-have-feelings/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'Do Ravens Have Feelings?', url: path },
];

const faq = [
  { q: 'Do ravens show empathy?', a: 'There is experimental evidence that ravens show behaviour consistent with empathy-like responses. Orlaith Fraser and Thomas Bugnyar (2010, published in PLOS ONE) demonstrated that after conflicts between ravens, bystander ravens approach and affiliate with the loser — behaviours that function to reduce the loser\'s stress and that mirror consolation behaviour documented in great apes. This was the first evidence of consolation behaviour in a non-mammal. Whether this involves subjective empathy or is better described as a functional emotional response is an open scientific question.' },
  { q: 'Can ravens grieve?', a: 'Ravens show behavioural responses to the deaths of conspecifics that have been described as grief-like: gathering around dead or dying individuals, calling, and remaining near the body. These observations are largely anecdotal in ravens (better-documented in crows — see Swift & Marzluff 2015 on "crow funerals"). Whether these responses involve something comparable to human grief — a subjective experience of loss — cannot be determined from behavioural data alone. What can be said is that ravens register the death of conspecifics as a significant event and respond to it.' },
  { q: 'Do ravens feel fear?', a: 'Yes — ravens show clear behavioural fear responses. They are highly neophobic (fearful of novel objects) in some contexts, particularly around food. Fear responses in ravens include alarm calls, fleeing, freezing, and prolonged wariness around novel items. Bernd Heinrich\'s work documented ravens repeatedly refusing to approach unfamiliar food items for extended periods, suggesting a strong neophobic fear system. This fear is functionally adaptive — cautious animals survive longer.' },
];
---

