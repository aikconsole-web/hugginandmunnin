const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'Do Ravens Remember Faces?', url: path },
];

const faq = [
  { q: 'Have ravens been tested for facial recognition in controlled experiments?', a: 'The most rigorous facial recognition research has been conducted with American Crows (Marzluff et al., 2010), not ravens. Crows were shown to remember specific human faces associated with capture and handling for at least 5 years, and to recruit others to mob those individuals. Ravens have not been the subject of equivalent masked-face experiments, but observations and indirect evidence suggest similar capacities.' },
  { q: 'Can ravens hold grudges against specific people?', a: 'Field observations and keeper accounts describe ravens treating familiar people differently depending on past experience — avoiding individuals who trapped or handled them while approaching those who fed them. The word "grudge" implies extended negative memory, and the evidence is consistent with this but mainly observational rather than from controlled experiments on ravens specifically.' },
  { q: 'How long can ravens remember faces?', a: 'The duration of raven-specific memory for individual faces has not been experimentally established. American Crow facial memory has been shown to persist for at least 5 years. Given ravens\' comparable or greater cognitive capacity, researchers consider long-term individual recognition plausible, but it has not been confirmed in ravens with the same rigour.' },
];
