];

const faq = [
  { q: 'Do ravens use tools?', a: 'Ravens show limited spontaneous tool use compared to New Caledonian Crows — the corvid tool-use champion. Ravens manipulate objects and show proto-tool behaviours (using objects to displace other objects), but have not been documented manufacturing or habitually using tools to extract food in the wild. In experimental settings, ravens have solved multi-step problems but typically prefer non-tool solutions when available.' },
