---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'How Big Are Ravens? — Size, Weight, and Wingspan Data';
const description = 'Common Ravens are 56–69 cm long with a 120–150 cm wingspan and weigh 689–1,625 g — making them the world\'s largest passerine. All 10 raven species compared by size.';
const path        = '/questions/how-big-are-ravens/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'How Big Are Ravens?', url: path },
];

const faq = [
  { q: 'How big is a raven compared to a crow?', a: 'A Common Raven is roughly 50% heavier than a Carrion Crow. Ravens are 56–69 cm long with a 120–150 cm wingspan; Carrion Crows are 44–51 cm with a 93–104 cm wingspan. The difference is immediately obvious when both species are seen together.' },
  { q: 'What is the largest raven species?', a: 'The Thick-billed Raven (Corvus crassirostris) of the Ethiopian Highlands rivals the Common Raven as the heaviest corvid, reaching 1,500 g and 70 cm in length — slightly longer than the typical Common Raven, though the ranges overlap.' },
  { q: 'Are ravens the largest black birds?', a: 'Common Ravens are among the largest black birds in their range but not the largest black bird overall. Some vultures and storks are larger. Within the corvid family (crows, jays, ravens), the Common Raven and Thick-billed Raven are the largest species.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

<article class="qa-page">
  <nav class="qa-breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
            ? <><a href={b.url}>{b.name}</a><span aria-hidden="true"> › </span></>
            : <span aria-current="page">{b.name}</span>}
        </li>
      ))}
    </ol>
  </nav>

  <header class="qa-header">
    <p class="qa-pillar">Question · Biology</p>
    <h1>How Big Are Ravens?</h1>
  </header>

  <section class="qa-snippet" aria-label="Direct answer">
    <p><strong class="claim-science">[science]</strong> The Common Raven (<em>Corvus corax</em>) is 56–69 cm (22–27 in) long, with a wingspan of 120–150 cm (47–59 in) and a weight of 689–1,625 g (1.5–3.6 lb). It is the world's largest passerine bird. Males are on average larger than females. The Thick-billed Raven of the Ethiopian Highlands is comparable in size and may rival or exceed the Common Raven at the top of the range.</p>
  </section>

  <section class="qa-section">
    <h2>Common Raven Measurements</h2>
    <dl class="qa-dl">
      <div><dt>Length</dt><dd>56–69 cm (22–27 in). Most birds are 60–65 cm.</dd></div>
      <div><dt>Wingspan</dt><dd>120–150 cm (47–59 in).</dd></div>
      <div><dt>Weight</dt><dd>689–1,625 g (1.5–3.6 lb). Most adults 800–1,200 g. Males average heavier than females.</dd></div>
      <div><dt>Tail</dt><dd>Wedge-shaped; 20–26 cm long in adults.</dd></div>
      <div><dt>Bill</dt><dd>5–7 cm, heavy and arched.</dd></div>
    </dl>
    <p class="qa-src-note">Source: Madge & Burn (1994), Boarman & Heinrich (1999).<sup><a href="#src-1">1</a><a href="#src-2">2</a></sup></p>
  </section>

  <section class="qa-section">
    <h2>All 10 Raven Species — Size Comparison</h2>
    <div class="qa-table-wrap">
      <table class="qa-table">
        <thead>
          <tr><th>Species</th><th>Length (cm)</th><th>Wingspan (cm)</th><th>Weight (g)</th></tr>
        </thead>
        <tbody>
          <tr><td><a href="/species/common-raven/">Common Raven</a></td><td>56–69</td><td>120–150</td><td>689–1,625</td></tr>
          <tr><td><a href="/species/thick-billed-raven/">Thick-billed Raven</a></td><td>60–70</td><td>up to 150</td><td>1,150–1,500</td></tr>
          <tr><td><a href="/species/white-necked-raven/">White-necked Raven</a></td><td>50–54</td><td>100–120</td><td>894–1,010</td></tr>
          <tr><td><a href="/species/chihuahuan-raven/">Chihuahuan Raven</a></td><td>44–51</td><td>100–115</td><td>430–590</td></tr>
          <tr><td><a href="/species/brown-necked-raven/">Brown-necked Raven</a></td><td>52–56</td><td>109–130</td><td>410–560</td></tr>
          <tr><td><a href="/species/fan-tailed-raven/">Fan-tailed Raven</a></td><td>~47</td><td>102–120</td><td>340–550</td></tr>
          <tr><td><a href="/species/somali-crow/">Somali Crow</a></td><td>44–46 (est.)</td><td>—</td><td>—</td></tr>
          <tr><td><a href="/species/australian-raven/">Australian Raven</a></td><td>46–53</td><td>100–120</td><td>560–750</td></tr>
          <tr><td><a href="/species/forest-raven/">Forest Raven</a></td><td>50–53</td><td>100–118</td><td>650–780</td></tr>
          <tr><td><a href="/species/little-raven/">Little Raven</a></td><td>48–50</td><td>96–110</td><td>340–460</td></tr>
        </tbody>
      </table>
    </div>
    <p class="qa-src-note">Sources: Madge & Burn (1994), BirdLife IUCN datasheets, HANZAB Vol 7. Somali Crow wingspan and weight not reliably published.<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="qa-section">
    <h2>What "Largest Passerine" Means</h2>
    <p><strong class="claim-science">[science]</strong> "Passerine" refers to the order Passeriformes — the perching birds — which includes about 60% of all bird species: sparrows, finches, warblers, crows, ravens, and thousands more. The Common Raven is the heaviest and among the longest of all passerine species in the world. This distinction is scientifically meaningful even if most people do not think of ravens and sparrows as belonging to the same group.<sup><a href="#src-2">2</a></sup></p>
  </section>

  <section class="qa-section">
    <h2>Related Pages</h2>
    <ul>
      <li><a href="/compare/raven-vs-crow/">Raven vs crow — size comparison and field marks</a></li>
      <li><a href="/species/common-raven/">Common Raven — full species profile</a></li>
    </ul>
  </section>

  <section class="qa-faq qa-section" aria-labelledby="faq-h2">
    <h2 id="faq-h2">Frequently Asked Questions</h2>
    {faq.map(item => (
      <details class="qa-faq-item">
        <summary class="qa-faq-q">{item.q}</summary>
        <p class="qa-faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <section class="qa-sources qa-section" aria-labelledby="src-h2">
    <h2 id="src-h2">Sources</h2>
    <ol class="qa-src-list">
      <li id="src-1">Madge, S. & Burn, H. (1994). <em>Crows and Jays</em>. Christopher Helm. — size data for all species.</li>
      <li id="src-2">Boarman, W.I. & Heinrich, B. (1999). Common Raven (<em>Corvus corax</em>). <em>Birds of the World</em>. Cornell Lab. — weight range, passerine classification.</li>
    </ol>
    <p class="qa-claim-note"><strong class="claim-science">[science]</strong> peer-reviewed/field-guide data</p>
  </section>
</article>
</BaseLayout>

