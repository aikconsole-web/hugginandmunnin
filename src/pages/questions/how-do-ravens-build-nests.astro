const title       = 'How Do Ravens Build Nests? Materials and Construction';
const description = 'Ravens build large stick nests on cliff ledges or in tall trees, lining them with wool, bark, grass, and hair. This page explains how ravens construct their nests, what materials they use, and how long nest-building takes.';
const path        = '/questions/how-do-ravens-build-nests/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'How Do Ravens Build Nests?', url: path },
];

const faq = [
  { q: 'What is a raven\'s nest made of?', a: 'A raven\'s nest has two layers: an outer structural platform of large sticks and branches (some up to 60 cm long), and an inner lining of softer materials. The lining typically includes wool, animal hair, dried grass, strips of bark, plant fibres, and — in areas near human habitation — occasionally cloth, string, or plastic. In pastoral areas, sheep wool is a consistently preferred lining material. Well-used nests accumulate years of added material and can become very large.' },
  { q: 'Do both ravens build the nest?', a: 'Both members of the pair contribute to nest construction, though the division of labour varies. In many observations, the female does most of the actual weaving and lining, while the male brings materials. Some studies suggest the male does more structural branch collection and the female more fine lining work, but roles overlap and vary between pairs. Nest construction typically takes 1–3 weeks for a new nest; refurbishment of an existing nest takes less time.' },
  { q: 'How long does a raven use the same nest?', a: 'Raven pairs show strong site fidelity and return to the same nest year after year. Each breeding season, they add more sticks and fresh lining material to the existing structure. Well-used nests accumulate decades of additions and become very large — sometimes over a metre across and deep. The same nest site may remain in use for 10–20+ years if the pair survives and the site remains undisturbed.' },
];
