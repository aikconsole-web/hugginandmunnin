        <p class="id-faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <section class="id-sources id-section" aria-labelledby="src-h2">
    <h2 id="src-h2">Sources</h2>
    <ol class="id-src-list">
      <li id="src-1">Madge, S. &amp; Burn, H. (1994). <em>Crows and Jays</em>. Christopher Helm. — in-flight identification features for all corvid species.</li>
    </ol>
    <p class="id-claim-note"><strong class="claim-science">[science]</strong> field-guide data</p>
  </section>

  <nav class="id-nav-bottom">
    <a href="/compare/raven-vs-crow/" class="id-back">← Raven vs Crow (full comparison)</a>
    <a href="/species/common-raven/identification/" class="id-next">Common Raven Identification →</a>
  </nav>
</article>
