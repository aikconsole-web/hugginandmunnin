import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'How Fast Can Ravens Fly?';
const description = 'Common Ravens cruise at around 25–50 km/h in level flight and can reach 80 km/h or more in a dive. This page covers raven flight speed, aerial agility, and how ravens compare to other large birds in speed and manoeuvrability.';
const path        = '/questions/how-fast-can-ravens-fly/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'How Fast Can Ravens Fly?', url: path },
];

const faq = [
  { q: 'What is a raven\'s top speed?', a: 'The Common Raven can reach speeds of approximately 80 km/h (50 mph) or more in a dive or powered descent — recorded in wind tunnel and field studies. In direct level flight, cruise speed is typically around 25–50 km/h, with higher speeds possible in short bursts or with a tailwind. These figures are consistent with other large corvids (rooks, crows), all of which are fast fliers for their size.' },
  { q: 'Are ravens fast fliers compared to other birds?', a: 'Ravens are fast and highly manoeuvrable for large birds — not in the class of falcons or swifts, but significantly faster and more agile than comparably sized raptors such as buzzards. Their long wings and relatively light build (for their size) produce efficient flapping flight. They are best known not for straight-line speed but for exceptional aerial agility — soaring, tumbling, and executing complex manoeuvres in strong winds, particularly during pair courtship displays.' },
  { q: 'Can ravens soar like eagles?', a: 'Yes. Ravens are capable and frequent thermal soarers. In areas with strong updrafts (mountain ridges, thermals over open ground), ravens soar for extended periods with minimal wingbeats. They exploit thermals and ridge lift in a manner similar to raptors, and are regularly observed soaring alongside vultures, eagles, and other large raptors. This soaring ability significantly extends their foraging range.' },
];
