const path        = '/questions/how-long-do-ravens-live-in-captivity/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'How Long Do Ravens Live in Captivity?', url: path },
];

const faq = [
  { q: 'What is the oldest recorded raven?', a: 'The oldest reliably documented raven was a captive individual named "Jimmy" at the Tower of London, reported to have lived to approximately 44 years. However, Tower of London raven records are not rigorously scientific. In peer-reviewed contexts, the longest-lived wild raven with confirmed band data was recorded at 23 years (a banded individual in North America); the longest captive ravens in controlled settings have been documented at 30–40+ years. The Tower of London\'s ravens (kept since at least the 17th century, with continuous care) represent the most famous long-lived raven population in the world.' },
  { q: 'How long do wild ravens typically live?', a: 'Wild Common Ravens typically live 10–15 years, with a maximum of approximately 20–25 years for the longest-lived individuals. Survival is lowest in the first year of life — predation, food scarcity, and inexperience kill many juveniles before their first birthday. Adults with established territories have higher annual survival rates (estimated 70–80% per year in some populations) but still face hazards including predation by eagles and large owls, human persecution (poisoning, shooting), collisions with vehicles and structures, and disease.' },
  { q: 'Why do captive ravens live so much longer than wild ravens?', a: 'Captive ravens live longer primarily because they are protected from the main causes of wild raven death: predation (zero predator pressure in captivity); food scarcity (fed reliably regardless of weather or season); accidental death (no vehicles, power lines, or traps); and disease (veterinary care available). The physiological lifespan of a raven — how long the body can function absent external mortality — is apparently 40+ years, as demonstrated by long-lived captive birds. Wild ravens rarely approach this because external mortality kills most birds long before they reach physiological age limits.' },
];
