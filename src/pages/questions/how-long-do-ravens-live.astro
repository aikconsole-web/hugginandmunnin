const title       = 'How Long Do Ravens Live?';
const description = 'Common Ravens (Corvus corax) live 10–15 years in the wild and up to 40+ years in captivity. This page explains the data, the record holders, and what determines raven lifespan.';
const path        = '/questions/how-long-do-ravens-live/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'How Long Do Ravens Live?', url: path },
];

const faq = [
  { q: 'What is the oldest raven ever recorded?', a: 'The oldest reliably documented wild Common Raven was at least 23 years old, based on ringing (banding) data from a European study. In captivity, ravens have lived into their 40s; the Tower of London ravens are reported to have reached 44 years, though individual records for captive birds are not always rigorously documented.' },
  { q: 'How long do Tower of London ravens live?', a: 'The Tower of London\'s ravens are captive birds. Tower records claim individual birds have lived into their 20s and beyond; one bird ("Jim Crow") is reported to have reached 44 years. These are institutional records, not independently verified scientific data.' },
  { q: 'Do ravens live longer than crows?', a: 'Yes, in general. American Crows typically live 7–8 years in the wild (maximum about 14 years, banding records). Common Ravens average 10–15 years in the wild with potential to exceed 20 years. The pattern — larger corvids live longer — is consistent with the broader relationship between body size and lifespan in birds.' },
];
---

