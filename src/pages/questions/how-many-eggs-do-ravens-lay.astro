 * Primary keyword: how many eggs do ravens lay
 * Secondary: raven clutch size, raven eggs, how many eggs does a raven lay
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'How Many Eggs Do Ravens Lay?';
const description = 'Ravens typically lay 3–7 eggs per clutch, with 4–6 most common in the Common Raven. Clutch size varies by species, habitat quality, and food availability. This page covers raven egg numbers, incubation, and hatching success.';
const path        = '/questions/how-many-eggs-do-ravens-lay/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'How Many Eggs Do Ravens Lay?', url: path },
];

const faq = [
  { q: 'How many eggs does a Common Raven lay?', a: 'The Common Raven typically lays 3–7 eggs per clutch, with 4–6 most common. Clutch size varies with food availability, female condition, and habitat quality. Ravens in productive environments (e.g., near carcass resources) tend to lay larger clutches than birds in marginal habitats. First-time breeders often lay smaller clutches than experienced pairs.' },
  { q: 'How long does it take for raven eggs to hatch?', a: 'Raven eggs incubate for approximately 20–21 days. Incubation is performed primarily by the female, with the male bringing food to her at the nest. Hatching is asynchronous — eggs laid at different times hatch over a period of a day or two, meaning chicks in the same nest are slightly different ages. All chicks fledge at approximately 5–6 weeks after hatching.' },
  { q: 'Do all raven eggs hatch?', a: 'Not all raven eggs hatch. Typical hatching success in well-studied Common Raven populations is 70–90% of eggs laid. Causes of egg failure include infertile eggs, predation (by foxes, owls, martens, and other corvids), disturbance causing nest abandonment, and cold weather during early incubation. Fledging success from hatched eggs is generally high: approximately 60–80% of hatched chicks fledge.' },
];
---

