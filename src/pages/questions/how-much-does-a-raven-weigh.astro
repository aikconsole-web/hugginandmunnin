/**
 * Q&A — How much does a raven weigh?
 * Primary keyword: how much does a raven weigh
 * Secondary: raven weight, raven mass, common raven size
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'How Much Does a Raven Weigh?';
const description = 'Common Ravens weigh 0.69–1.63 kg (1.5–3.6 lb) depending on sex, subspecies and condition. This page gives weights for all ten raven species and explains the variation.';
const path        = '/questions/how-much-does-a-raven-weigh/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'How Much Does a Raven Weigh?', url: path },
];

const faq = [
  { q: 'How much heavier is a raven than a crow?', a: 'The Common Raven weighs roughly 2–4 times as much as the American Crow. American Crows typically weigh 316–620 g (0.7–1.4 lb); Common Ravens weigh 690–1,630 g (1.5–3.6 lb). In Europe, Carrion Crows weigh 370–650 g against the Common Raven\'s similar range, making the size difference somewhat smaller but still substantial.' },
  { q: 'Which is the heaviest raven species?', a: 'The Thick-billed Raven (Corvus crassirostris) of the Ethiopian Highlands is widely considered the heaviest corvid. Published weights reach approximately 1,500 g (3.3 lb) or more. The Common Raven can reach similar maxima in its largest Arctic subspecies, but the Thick-billed Raven consistently averages heavier.' },
  { q: 'Do male ravens weigh more than females?', a: 'Yes. Ravens show sexual size dimorphism, with males averaging heavier than females. In Common Ravens, males typically outweigh females by about 10–15%. The same pattern holds across raven species, though the degree varies.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

