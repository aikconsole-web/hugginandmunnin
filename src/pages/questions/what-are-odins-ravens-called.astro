---
/**
 * Q&A — What are Odin's ravens called?
 * Primary keyword: what are odin's ravens called
 * Secondary: odin ravens names, huginn and muninn names
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'What Are Odin\'s Ravens Called?';
const description = 'Odin\'s two ravens are called Huginn ("Thought") and Muninn ("Memory"). Their names appear in the Old Norse poem Grímnismál, stanza 20. This page answers directly with the textual evidence.';
const path        = '/questions/what-are-odins-ravens-called/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: "What Are Odin's Ravens Called?", url: path },
];

const faq = [
  { q: 'What do Huginn and Muninn mean in English?', a: 'Huginn means "Thought" in Old Norse (from hugr, "thought/mind"). Muninn means "Memory" (from muna, "to remember"), though some scholars also translate it as "desire" or "mind". The names appear in Grímnismál stanza 20, the only surviving verse that names both ravens.' },
  { q: 'Which raven is Huginn and which is Muninn?', a: 'No primary source assigns specific roles to each raven individually — they appear as a pair that together gather news. Grímnismál stanza 20 mentions Odin\'s greater fear for Muninn\'s return, but does not specify which raven handles which type of information.' },
  { q: 'Did Odin have more than two ravens?', a: 'No primary source gives Odin more than two ravens. Grímnismál stanza 20 names Huginn and Muninn as a pair, and Gylfaginning ch. 38 confirms two ravens. No other named ravens are attributed to Odin in the surviving Eddas.' },
];
---

