 * Primary keyword: what colour are raven eggs
 * Secondary: raven egg colour, what do raven eggs look like, raven egg description
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'What Colour Are Raven Eggs?';
const description = 'Raven eggs are pale blue-green to greenish, heavily blotched with brown, grey, and olive markings. This page covers raven egg colour, appearance, clutch size, and how to identify raven eggs from other corvid eggs.';
const path        = '/questions/what-colour-are-raven-eggs/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'What Colour Are Raven Eggs?', url: path },
];

const faq = [
  { q: 'What do raven eggs look like?', a: 'Raven eggs are pale blue-green to greenish-grey or olive-blue, heavily marked with brown, grey, and olive-brown blotches, spots, and streaks. The blotching is typically concentrated at the larger end of the egg. Eggs are oval, measuring approximately 48–52 mm long by 33–35 mm wide in the Common Raven. The ground colour can vary from fairly bright blue-green to dull brownish-green depending on individual variation.' },
  { q: 'How many eggs do ravens lay in a clutch?', a: 'Common Ravens typically lay 3–7 eggs per clutch, with 4–6 most common. Clutch size varies with food availability, female condition, and habitat quality. Some raven species vary: the Chihuahuan Raven typically lays 4–7 eggs (larger average); the White-necked Raven and other African/Middle Eastern species typically lay 3–5 eggs. Eggs are laid at approximately 24-hour intervals; incubation begins with the first or second egg, producing hatching asynchrony.' },
  { q: 'Can you identify raven eggs by sight?', a: 'Identifying raven eggs with certainty requires knowing the nest belongs to a raven rather than another large corvid. The eggs themselves overlap in appearance with other large corvid eggs (carrion crow, hooded crow, jackdaw). The best identification is by context: a large stick nest on a cliff ledge or in the top of a tall tree, with one or both raven parents nearby. Egg size (larger than crow, smaller than a chicken egg) and the classic blue-green base with heavy brown blotching is consistent with the description.' },
];
---

