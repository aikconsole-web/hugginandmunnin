const title       = 'What Do Raven Eggs Look Like? Size, Colour, and Clutch';
const description = 'Common Raven eggs are pale blue-green with brown and grey spots, 48–55 mm long, laid in clutches of 3–7. Incubation 20–21 days by the female. Field guide data.';
const path        = '/questions/what-do-raven-eggs-look-like/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'What do raven eggs look like?', url: path },
];

const faq = [
  { q: 'What do raven eggs look like?', a: 'Common Raven eggs are pale blue-green or greenish-grey, heavily spotted and blotched with brown, olive-brown, and grey. They measure approximately 48–55 mm long × 32–38 mm wide. A typical clutch is 3–7 eggs. The female incubates alone for 20–21 days while the male brings food to the nest.' },
  { q: 'How many eggs do ravens lay?', a: 'Common Ravens typically lay 3–7 eggs per clutch, with 4–6 being most common. They usually raise one brood per year. Incubation lasts 20–21 days; chicks fledge at approximately 35–42 days. Both parents feed the chicks, but only the female incubates.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

