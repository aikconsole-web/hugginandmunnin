import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'What Do Ravens Eat?';
const description = 'Common Ravens are omnivores that eat almost anything: carrion, small mammals, eggs, berries, grain, invertebrates, and human refuse. This page covers their diet in full detail with sourced data.';
const path        = '/questions/what-do-ravens-eat/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'What Do Ravens Eat?', url: path },
];

const faq = [
  { q: 'Do ravens eat live animals?', a: 'Yes. Ravens kill and eat small to medium-sized prey including rodents, rabbits, lizards, frogs, and nestlings of other birds. They also scavenge larger carcasses they cannot kill themselves. Their diet is flexible: they will take whatever is most available.' },
  { q: 'Do ravens eat carrion (dead animals)?', a: 'Carrion is a major food source for ravens, especially in winter when other food is scarce. Ravens are attracted to large carcasses — ungulates, domestic livestock, and roadkill. They may gather in groups around a carcass and can displace smaller scavengers.' },
  { q: 'Can ravens eat human food?', a: 'Ravens readily eat human refuse, scraps, and stored food — they are well-known opportunists around campsites, landfills, and towns. Human food is nutritionally fine for ravens (they are omnivores), though feeding wild ravens is generally not recommended as it habituates them to human presence and can create conflicts.' },
];
---

