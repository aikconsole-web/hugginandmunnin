const path        = '/questions/what-does-a-baby-raven-look-like/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'What Does a Baby Raven Look Like?', url: path },
];

const faq = [
  { q: 'How do I know if a raven on the ground is a baby?', a: 'A fledgling raven (recently left the nest) has a short tail, a pink or pale bill gape, blue-grey or dark brown eyes, and plumage that is dull brownish-black rather than the glossy iridescent black of adults. The gape flanges — fleshy ridges at the base of the bill — may still be visible. If it is hopping and flapping but not flying well, it has likely fledged recently and is usually best left alone unless injured.' },
  { q: 'How long do baby ravens stay with their parents?', a: 'Fledglings leave the nest at about 35–42 days [science] but remain dependent on their parents for food and guidance for a further four to six weeks after fledging. By late summer the family group typically breaks up and young ravens join non-breeding flocks, where they spend one to three years before pairing.' },
  { q: 'Can you tell a juvenile raven from an adult?', a: 'Yes. Juvenile and first-year ravens have browner, less glossy plumage, a less prominent throat hackle, blue-grey (not dark brown) irises, and a pinkish mouth interior. Adults have fully black, iridescent plumage, a well-developed hackle, and deep brown eyes. The transition to adult-like plumage takes about two to three years.' },
];
