const title       = 'What Does a Raven Look Like? A Complete Description';
const description = 'The Common Raven is a large, all-black bird with a heavy arched bill, shaggy throat hackles, a wedge-shaped tail, and long, broad wings. This page describes its appearance in full — size, plumage, bill, tail, and how it compares to crows.';
const path        = '/questions/what-does-a-raven-look-like/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'What Does a Raven Look Like?', url: path },
];

const faq = [
  { q: 'How big is a raven?', a: 'The Common Raven is the largest member of the order Passeriformes (perching birds). Body length is 56–69 cm (22–27 inches); wingspan 115–150 cm (45–59 inches); weight 700–1,600 g (1.5–3.5 lb), with considerable variation across its range. Alaskan and northern European ravens are significantly larger than those from desert populations.' },
  { q: 'What colour is a raven?', a: 'The Common Raven is all black — but not a flat black. Its plumage shows iridescent blue-green, purple, and violet gloss in good light, particularly on the wings and back. The colour shifts with viewing angle, from dull sooty black in poor light to glossy metallic in direct sun. Juvenile birds have a duller, browner-black plumage with less gloss, gradually acquiring full adult iridescence over 2–3 years.' },
  { q: 'What is special about a raven\'s tail?', a: 'The Common Raven has a distinctive wedge-shaped or diamond-shaped tail — the central tail feathers are longer than the outer feathers, producing a pointed central projection visible in flight. This is one of the most reliable identification features distinguishing ravens from crows (which have fan-shaped tails with more uniform feather lengths). The wedge tail is visible both when soaring and when the bird is perched and spreads its tail.' },
];
