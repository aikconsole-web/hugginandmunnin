import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'When Do Ravens Nest?';
const description = 'Common Ravens are among the earliest-nesting birds in the Northern Hemisphere, beginning nest repairs in January and laying eggs as early as February–March. This page covers the full nesting timeline.';
const path        = '/questions/when-do-ravens-nest/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'When Do Ravens Nest?', url: path },
];

const faq = [
  { q: 'Why do ravens nest so early in the year?', a: 'Ravens nesting in late winter benefit from hatching chicks when spring food abundance is rising — the timing aligns chick provisioning with the period of maximum food availability in late spring and early summer. Early nesting also allows fledged young to have more time to learn foraging skills before their first winter. The cold-climate timing is similar to that of other large raptors like eagles and owls.' },
  { q: 'How many times a year do ravens nest?', a: 'Ravens are single-brooded — they raise one clutch per year. If a first clutch fails (nest destroyed, eggs predated), a pair may attempt a replacement clutch at the same or a different site, but this is not guaranteed. Raising a second brood after successfully fledging young from the first is not known in Common Ravens.' },
  { q: 'Do ravens use the same nest every year?', a: 'Yes — pairs typically return to the same nest site year after year and add new material to the existing structure. Raven nests grow substantially with repeated use, sometimes becoming very large structures of sticks, wool, grass, and mud. Some nest sites are known to have been in continuous use for decades.' },
];
---

