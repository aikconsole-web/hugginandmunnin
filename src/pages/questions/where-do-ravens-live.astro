  .qa-page h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 2rem; line-height: 1.1; }
  .qa-snippet { background: rgba(212,174,90,.08); border-left: 3px solid var(--gold-500, #d4ae5a); border-radius: 0 6px 6px 0; padding: 1rem 1.25rem; margin-bottom: 2.5rem; font-size: 1.03rem; }
  .qa-section { margin-bottom: 2.5rem; }
  .qa-section h2 { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 600; color: #fff; margin: 0 0 .9rem; border-bottom: 1px solid rgba(212,174,90,.2); padding-bottom: .4rem; }
  .qa-section p { margin: 0 0 1rem; font-size: .97rem; }
  .qa-section ul { padding-left: 1.25rem; margin: 0 0 1rem; }
  .qa-section li { margin-bottom: .4rem; font-size: .95rem; }
  .claim-science { color: #7ab9e0; font-style: normal; font-size: .78rem; }
  a[href] { color: var(--gold-500, #d4ae5a); }
