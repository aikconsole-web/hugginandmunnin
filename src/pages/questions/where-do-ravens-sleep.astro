const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'Where Do Ravens Sleep?', url: path },
];

const faq = [
  { q: 'Do ravens sleep in the same place every night?', a: 'Paired territory-holding ravens tend to roost on or near their territory, often in a tall tree or on a cliff ledge, with considerable consistency. Unpaired, non-breeding ravens in communal flocks use regular roost sites — often the same woodland patch or cliff for seasons or years — but the composition of the flock at any given roost changes as birds move in and out.' },
  { q: 'How big can raven roosts be?', a: 'Raven roosts vary enormously by region, season, and food availability. Small roosts of 10–50 birds are common; larger roosts of several hundred to over 2,000 have been recorded in areas with abundant winter food (e.g., near abattoirs, landfill sites, or large ungulate carcasses). The largest roosts tend to be in autumn and winter when juveniles and non-breeders concentrate.' },
  { q: 'Why do ravens roost together?', a: 'The leading hypothesis is Bernd Heinrich\'s "information-centre hypothesis": communal roosts allow birds that found food on a given day to be followed to that food the next morning by birds that did not find food. This creates a social information network. Supporting evidence is that naïve, food-deprived birds follow fed birds from roosts. However, anti-predator benefits and warmth retention may also contribute.' },
];
