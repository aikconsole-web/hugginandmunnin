const title       = 'Why Are Ravens Associated With Death?';
const description = 'Ravens are associated with death because they are carrion birds — they eat the dead and historically gathered at battlefields. This page explains the ecological basis and the cultural traditions it inspired.';
const path        = '/questions/why-are-ravens-associated-with-death/';

const breadcrumbs = [
  { name: 'Home',      url: '/' },
  { name: 'Questions', url: '/questions/' },
  { name: 'Why Are Ravens Associated With Death?', url: path },
];

const faq = [
  { q: 'Did ravens really appear at Viking battlefields?', a: 'Yes — ravens are attracted to large carcasses and would have gathered at battlefields throughout history. This is documented behaviour: ravens follow wolves and other predators to access kills, and historically followed armies. The Viking "beasts of battle" motif in Old Norse poetry reflects genuine observation.' },
  { q: 'Are ravens death omens in all cultures?', a: 'No. The death-omen association is strongest in certain European traditions. In Norse mythology, ravens were signs of Odin\'s presence and wisdom, not simply death. In several Pacific Northwest Indigenous traditions, the Raven is a creator figure. The death association is real in some cultures but far from universal.' },
];
---

