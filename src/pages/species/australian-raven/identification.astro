---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title       = 'Australian Raven Identification — Field Guide';
const description = 'How to identify the Australian Raven (Corvus coronoides): throat hackles, eye colour, calls, and separation from Forest Raven and Little Raven. Sourced measurements.';
const path        = '/species/australian-raven/identification/';

const breadcrumbs = [
  { name: 'Home',             url: '/' },
  { name: 'Species',          url: '/species/' },
  { name: 'Australian Raven', url: '/species/australian-raven/' },
  { name: 'Identification',   url: path },
];

const faq = [
  { q: 'How do I identify an Australian Raven?', a: 'The Australian Raven is large (46–53 cm) with a heavy bill, shaggy throat hackles (the most prominent of the three Australian large corvids), white eye (adult), and entirely black plumage. The call is a distinctive long, wailing "aah-aah-aaahh" that falls away at the end — very different from the other Australian corvids.' },
  { q: 'What is the difference between an Australian Raven and a Forest Raven?', a: 'The Forest Raven (Corvus tasmanicus) is slightly smaller, has a shorter, rounder bill, a shorter tail, and gives a deeper, more guttural call. The Australian Raven\'s call falls away at the end (wailing); the Forest Raven\'s call is more abrupt. Range also helps: Forest Raven is largely restricted to Tasmania and limited areas of Victoria and southern NSW.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

<article class="id-page">
  <nav class="id-breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
            ? <><a href={b.url}>{b.name}</a><span aria-hidden="true"> › </span></>
            : <span aria-current="page">{b.name}</span>}
        </li>
      ))}
    </ol>
  </nav>
  <header class="id-header">
    <p class="id-pillar">Species · Field Identification</p>
    <h1>Australian Raven — Identification</h1>
    <p class="id-subtitle"><em>Corvus coronoides</em></p>
  </header>

  <section class="id-snippet" aria-label="Quick answer">
    <p><strong class="claim-science">[science]</strong> Key identification features: large size (46–53 cm), very prominent shaggy throat hackles, white iris (adults), entirely black plumage with blue-green iridescence, heavy arched bill, and a long wailing call "aah-aah-aaahh" that falls at the end. The Australian Raven is the largest and most widespread of Australia's corvids.</p>
  </section>

  <section class="id-section">
    <h2>Measurements</h2>
    <div class="id-table-wrap">
      <table class="id-table">
        <thead><tr><th>Measurement</th><th>Range</th></tr></thead>
        <tbody>
          <tr><td>Length</td><td>46–53 cm</td></tr>
          <tr><td>Wingspan</td><td>100 cm (approx.)</td></tr>
          <tr><td>Weight</td><td>650–750 g (approx.)</td></tr>
        </tbody>
      </table>
    </div>
    <p class="id-src-note">Source: Madge &amp; Burn (1994).<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="id-section">
    <h2>Key Field Marks</h2>

    <h3>Throat Hackles</h3>
    <p><strong class="claim-science">[science]</strong> The Australian Raven has the most prominent throat hackles of the three large Australian corvids (Australian Raven, Forest Raven, Little Raven). They are long, shaggy, and highly visible — typically held erect during calling. This is a reliable mark separating it from the smaller Australian Crow (<em>Corvus orru</em>) and Torresian Crow, which have less prominent hackles.<sup><a href="#src-1">1</a></sup></p>

    <h3>Eye Colour</h3>
    <p><strong class="claim-science">[science]</strong> Adult Australian Ravens have a <strong>white iris</strong>. Juveniles have brown eyes, gradually lightening. The white eye is shared with other Australian corvids (Forest Raven, Little Raven) and so is not useful for separating the large corvids from each other — but it separates all native Australian corvids from Common Ravens (<em>Corvus corax</em>), which have dark eyes.<sup><a href="#src-1">1</a></sup></p>

    <h3>Bill</h3>
    <p><strong class="claim-science">[science]</strong> Heavy, arched bill, larger than in Little Raven and Australian Crow but not quite as massive as Common Raven.</p>

    <h3>Call</h3>
    <p><strong class="claim-science">[science]</strong> The Australian Raven's call is one of the best identification marks. It gives a long, wailing "aah-aah-aaahh" sequence that notably <strong>falls away</strong> at the end — a descending, drawn-out wail. The Forest Raven's call is deeper and more guttural; the Little Raven's call is shorter, higher, and quicker.<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="id-section">
    <h2>Separation from Similar Species</h2>
    <ul>
      <li><strong>Forest Raven (<em>C. tasmanicus</em>):</strong> Shorter tail, shorter bill, more guttural call, mostly restricted to Tasmania and south-eastern Australia.</li>
      <li><strong>Little Raven (<em>C. mellori</em>):</strong> Smaller (45–48 cm), shorter and more rounded wings, faster wingbeats, higher-pitched call; often in flocks.</li>
      <li><strong>Australian Crow (<em>C. orru</em>):</strong> Similar size but bill less heavy, call very different (shorter, higher "aak"), less prominent hackles.</li>
    </ul>
  </section>

  <section class="id-faq id-section" aria-labelledby="faq-h2">
    <h2 id="faq-h2">Frequently Asked Questions</h2>
    {faq.map(item => (
      <details class="id-faq-item">
        <summary class="id-faq-q">{item.q}</summary>
        <p class="id-faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <section class="id-sources id-section" aria-labelledby="src-h2">
    <h2 id="src-h2">Sources</h2>
    <ol class="id-src-list">
      <li id="src-1">Madge, S. &amp; Burn, H. (1994). <em>Crows and Jays</em>. Christopher Helm. — all measurements, field marks, and Australian corvid comparisons.</li>
    </ol>
    <p class="id-claim-note"><strong class="claim-science">[science]</strong> field-guide data</p>
  </section>

  <nav class="id-nav-bottom">
    <a href="/species/australian-raven/" class="id-back">← Australian Raven Overview</a>
    <a href="/species/australian-raven/range-and-habitat/" class="id-next">Range and Habitat →</a>
  </nav>
</article>
</BaseLayout>

