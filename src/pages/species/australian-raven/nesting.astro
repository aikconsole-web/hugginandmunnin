const description = 'The Australian Raven builds a large stick nest in the fork of a tall tree and breeds from July to October. This page covers nest structure, clutch size, incubation, and the breeding season of Corvus coronoides.';
const path        = '/species/australian-raven/nesting/';

const breadcrumbs = [
  { name: 'Home',              url: '/' },
  { name: 'Species',           url: '/species/' },
  { name: 'Australian Raven',  url: '/species/australian-raven/' },
  { name: 'Nesting',           url: path },
];

const faq = [
  { q: 'Where does the Australian Raven nest?', a: 'The Australian Raven nests in the fork or on a horizontal branch of a tall tree — typically a large eucalyptus in open woodland, pastoral land, or the edge of towns. Unlike cliff-nesting ravens (such as the White-necked Raven of Africa), the Australian Raven is primarily a tree-nester across its range in south-eastern and south-western Australia.' },
  { q: 'When does the Australian Raven breed?', a: 'The Australian Raven breeds from approximately July to October — the Southern Hemisphere late-winter to spring. Egg-laying typically peaks August–September. The timing varies slightly with latitude and local conditions but is broadly consistent across the species\' range in south-eastern and south-western Australia.' },
  { q: 'How many eggs does the Australian Raven lay?', a: 'Clutch size is typically 4–6 eggs, slightly larger than many Northern Hemisphere raven species. Eggs are pale blue-green to greenish, blotched with brown and grey. Incubation is approximately 20 days, primarily by the female. Chicks fledge at approximately 5–6 weeks, but family groups remain together for some months after fledging.' },
];
---

