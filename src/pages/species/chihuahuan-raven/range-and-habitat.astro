---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title       = 'Chihuahuan Raven Range and Habitat — Desert Southwest';
const description = 'The Chihuahuan Raven (Corvus cryptoleucus) is a raven of arid desert grasslands in the southwestern US and northern Mexico. Range, habitat preferences, and population status.';
const path        = '/species/chihuahuan-raven/range-and-habitat/';

const breadcrumbs = [
  { name: 'Home',             url: '/' },
  { name: 'Species',          url: '/species/' },
  { name: 'Chihuahuan Raven', url: '/species/chihuahuan-raven/' },
  { name: 'Range and Habitat', url: path },
];

const faq = [
  { q: 'Where does the Chihuahuan Raven live?', a: 'The Chihuahuan Raven is found in arid desert grasslands, desert scrub, and agricultural land in the southwestern United States (Texas, New Mexico, Arizona, Colorado, Oklahoma) and northern Mexico (Chihuahua, Sonora, Coahuila, Zacatecas, Durango). It is a bird of flat open desert — not mountains or forests.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

<article class="id-page">
  <nav class="id-breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
            ? <><a href={b.url}>{b.name}</a><span aria-hidden="true"> › </span></>
            : <span aria-current="page">{b.name}</span>}
        </li>
      ))}
    </ol>
  </nav>
  <header class="id-header">
    <p class="id-pillar">Species · Range and Habitat</p>
    <h1>Chihuahuan Raven — Range and Habitat</h1>
    <p class="id-subtitle"><em>Corvus cryptoleucus</em> · Desert Southwest</p>
  </header>

  <section class="id-snippet" aria-label="Quick answer">
    <p><strong class="claim-science">[science]</strong> The Chihuahuan Raven is restricted to arid desert grasslands, desert scrub, and open agricultural land in the southwestern US and northern Mexico — the Chihuahuan Desert region and its margins. It is a bird of flat open desert, not mountainous terrain. Where its range overlaps with Common Raven, habitat is a key separator. Conservation status: Least Concern (IUCN).</p>
  </section>

  <section class="id-section">
    <h2>Range</h2>
    <p><strong class="claim-science">[science]</strong> Southwestern US and northern Mexico:</p>
    <ul>
      <li><strong>United States:</strong> Texas (panhandle, trans-Pecos, south Texas), New Mexico (most of state except high mountains), Arizona (south-east), Colorado (south-east corner), Oklahoma (panhandle)</li>
      <li><strong>Mexico:</strong> Chihuahua, Sonora (north-east), Coahuila, Nuevo León, Zacatecas, Durango, San Luis Potosí (north)</li>
    </ul>
    <p>The range corresponds largely to the Chihuahuan Desert and surrounding semi-arid grasslands — the species name reflects this.<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="id-section">
    <h2>Habitat</h2>
    <p><strong class="claim-science">[science]</strong> Desert specialist of flat, open terrain:</p>
    <ul>
      <li>Arid grassland (grama grass, tobosa grass desert plains)</li>
      <li>Desert scrub — creosote bush, mesquite, yucca plains</li>
      <li>Agricultural land — cultivated fields, feedlots, and rangelands in the Chihuahuan Desert zone</li>
      <li>Avoids: mountains, forest, dense chaparral, highly urbanised areas</li>
    </ul>
    <p>Where Common Ravens and Chihuahuan Ravens co-occur in the same general area (e.g., parts of New Mexico and Arizona), they tend to be ecologically separated — Common Ravens use higher-elevation, rockier terrain while Chihuahuan Ravens use the flat desert floor. This habitat separation is a useful identification guide at range boundaries.<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="id-section">
    <h2>Colonial Nesting and Winter Flocks</h2>
    <p><strong class="claim-science">[science]</strong> Chihuahuan Ravens nest more colonially than Common Ravens — loose groups of nests in yucca, power poles, and other structures are typical. In winter they form large communal roosts of hundreds to thousands of birds — much more than typical Common Raven behaviour. A large winter flock of ravens in the Texas panhandle is almost certainly Chihuahuan Ravens.<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="id-section">
    <h2>Conservation Status</h2>
    <p><strong class="claim-science">[science]</strong> <strong>Least Concern</strong> (IUCN Red List). Population not globally threatened; benefits from agricultural waste and rangelands in its range.</p>
  </section>

  <section class="id-faq id-section" aria-labelledby="faq-h2">
    <h2 id="faq-h2">Frequently Asked Questions</h2>
    {faq.map(item => (
      <details class="id-faq-item">
        <summary class="id-faq-q">{item.q}</summary>
        <p class="id-faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <section class="id-sources id-section" aria-labelledby="src-h2">
    <h2 id="src-h2">Sources</h2>
    <ol class="id-src-list">
      <li id="src-1">Madge, S. &amp; Burn, H. (1994). <em>Crows and Jays</em>. Christopher Helm. — range, habitat, and nesting behaviour.</li>
    </ol>
    <p class="id-claim-note"><strong class="claim-science">[science]</strong> field-guide data</p>
  </section>

  <nav class="id-nav-bottom">
    <a href="/species/chihuahuan-raven/identification/" class="id-back">← Identification</a>
    <a href="/species/chihuahuan-raven/" class="id-next">Chihuahuan Raven Overview →</a>
  </nav>
</article>
</BaseLayout>

