const title       = 'Common Raven Range: Where This Species Lives';
const description = 'The Common Raven has one of the widest ranges of any bird — from Arctic Alaska and Canada to the Sahara, from Ireland to the Pacific coast of Asia. This page covers the full distribution, habitat preferences, and population density of Corvus corax.';
const path        = '/species/common-raven/range/';

const breadcrumbs = [
  { name: 'Home',          url: '/' },
  { name: 'Species',       url: '/species/' },
  { name: 'Common Raven',  url: '/species/common-raven/' },
  { name: 'Range',         url: path },
];

const faq = [
  { q: 'Where does the Common Raven live?', a: 'The Common Raven (Corvus corax) is one of the most widely distributed land birds in the world. It is resident across most of the Northern Hemisphere: from northern Alaska and Canada across the boreal zone of North America to Greenland; across all of Europe and Scandinavia; across the Middle East, Central Asia, and Himalayas; and in the mountains of North Africa (Atlas Mountains, Morocco, Algeria). It is absent only from the Arctic Ocean islands, densely forested lowland tropics, and most of Asia south of the Himalayas.' },
  { q: 'What habitats do Common Ravens prefer?', a: 'Common Ravens are habitat generalists but prefer open or semi-open terrain with cliff sites for nesting. Optimal habitats include: coastal cliffs and sea-bird colonies; mountain plateaus and rocky uplands; boreal forest and taiga edges; Arctic and subarctic tundra; desert and semi-desert terrain with rocky outcrops. They are also increasingly associated with human infrastructure — roads, landfills, farm buildings — in many parts of their range. Dense closed-canopy lowland forest is suboptimal; ravens prefer to soar and need open areas for foraging.' },
  { q: 'Have Common Ravens expanded their range?', a: 'Yes, in several regions. In Britain, ravens were largely extirpated from England by the late 19th century through persecution. Since legal protection in 1981, the breeding range has expanded steadily eastward and southward from Wales and Scotland. As of the 2020s, ravens breed in most English counties. In the western US and Canada, ravens have expanded into agricultural areas with human food subsidies (landfills, roads). In contrast, persecuted populations in some parts of Europe remain below historical range.' },
];
---

