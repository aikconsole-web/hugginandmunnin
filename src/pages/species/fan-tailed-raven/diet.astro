const title       = 'Fan-tailed Raven Diet: What This Species Eats';
const description = 'The Fan-tailed Raven of the Horn of Africa and Middle East is an omnivore closely associated with cliffs and rocky habitats. Its diet includes invertebrates, carrion, grain, and food waste from human settlements. Full diet breakdown.';
const path        = '/species/fan-tailed-raven/diet/';

const breadcrumbs = [
  { name: 'Home',            url: '/' },
  { name: 'Species',         url: '/species/' },
  { name: 'Fan-tailed Raven', url: '/species/fan-tailed-raven/' },
  { name: 'Diet',            url: path },
];

const faq = [
  { q: 'What does the Fan-tailed Raven eat?', a: 'The Fan-tailed Raven is an omnivore. Its diet includes invertebrates (beetles, grasshoppers, termites), grain and seeds, fruit, small vertebrates, carrion, and human food waste from villages and urban areas in its range across the Horn of Africa, the Middle East, and the Arabian Peninsula. The species is closely associated with cliff and rocky terrain, and forages in adjacent agricultural land and settlements.' },
  { q: 'Is the Fan-tailed Raven a scavenger?', a: 'Yes, partly. Carrion is a component of the Fan-tailed Raven\'s diet, as with all large corvids. However, it is a less committed scavenger than the White-necked Raven or Thick-billed Raven — its lighter, smaller bill (relative to larger raven species) is better suited to invertebrates and small food items than to opening large carcasses. At mixed-species assemblages at carcasses, it tends to be subordinate to larger corvids.' },
  { q: 'Where does the Fan-tailed Raven find food?', a: 'The Fan-tailed Raven forages in cliff and rocky habitats, in adjacent scrub and open ground, in agricultural fields, and around human settlements. In Ethiopia, Eritrea, Somalia, Yemen, and Oman, it is a common visitor to towns and villages where it exploits food waste and market scraps. It is a highly synanthropic species (closely associated with human settlements) in much of its range.' },
];
