import BaseLayout from '../../../layouts/BaseLayout.astro';

const title       = 'Forest Raven Diet: What This Species Eats';
const description = 'The Forest Raven of Tasmania and south-east Australia is an omnivore that exploits a wide range of forest and farmland food items including carrion, invertebrates, grain, and human food waste. Full diet breakdown.';
const path        = '/species/forest-raven/diet/';

const breadcrumbs = [
  { name: 'Home',         url: '/' },
  { name: 'Species',      url: '/species/' },
  { name: 'Forest Raven', url: '/species/forest-raven/' },
  { name: 'Diet',         url: path },
];

const faq = [
  { q: 'What does the Forest Raven eat?', a: 'The Forest Raven is a broad omnivore. Its diet includes carrion (roadkill, dead livestock), invertebrates, small vertebrates, eggs, grain and seeds, fruit, and human food waste. In Tasmania, where the species is most abundant, it exploits both native forest habitats and agricultural and urban environments. It is one of the most ecologically flexible of the Australian corvids.' },
  { q: 'Is the Forest Raven a threat to livestock?', a: 'Like the Australian Raven, the Forest Raven has historically been implicated in attacks on weakened or newborn lambs in Tasmania and south-eastern Australia. The pattern mirrors that documented for the Australian Raven: most attacks involve already-stressed animals, but the species is bold enough to investigate newborns. In Tasmania, where the Forest Raven is the dominant large corvid, it has been subject to management and study in relation to lamb losses.' },
  { q: 'How does the Forest Raven find food?', a: 'The Forest Raven is primarily a ground-forager, walking and probing for invertebrates and opportunistically attending carcasses and other food sources. It also forages in trees for insects, eggs, and fruit. The species is highly observant and will follow farm machinery (tractors, ploughs) to take exposed invertebrates. In urban areas it exploits bins, compost, and food waste.' },
];
---

