import BaseLayout from '../../../layouts/BaseLayout.astro';

const title       = 'Forest Raven Nesting: Breeding and Nest Sites';
const description = 'The Forest Raven of Tasmania and south-eastern Australia nests in tall eucalypts and breeds July–October. This page covers nest structure, clutch size, incubation, and the breeding season of Corvus tasmanicus.';
const path        = '/species/forest-raven/nesting/';

const breadcrumbs = [
  { name: 'Home',          url: '/' },
  { name: 'Species',       url: '/species/' },
  { name: 'Forest Raven',  url: '/species/forest-raven/' },
  { name: 'Nesting',       url: path },
];

const faq = [
  { q: 'Where does the Forest Raven nest?', a: 'The Forest Raven nests in tall trees — primarily large eucalypts in tall open forest and montane woodland. In Tasmania, where it is the dominant large corvid, it uses a wide range of forest types. On the mainland (Victoria, New South Wales, South Australia), it is restricted to montane and south-coastal areas where tall wet forest occurs. It places its nest in the fork or on a stout branch, usually high in the tree.' },
  { q: 'When does the Forest Raven breed?', a: 'Breeding is from approximately July to October. Egg-laying typically peaks in August–September — the Southern Hemisphere late-winter to spring. Fledging occurs from October onward. The pattern closely mirrors that of the Australian Raven, its nearest relative, with slightly variable timing across the latitudinal range.' },
  { q: 'How many eggs does the Forest Raven lay?', a: 'Clutch size is typically 3–5 eggs — slightly smaller on average than the Australian Raven. Eggs are pale blue-green to greenish-grey, blotched with brown and grey. Incubation is approximately 20 days. Post-fledging dependence lasts several months, with family groups remaining loosely cohesive through autumn.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

<article class="qa-page">

  <nav class="qa-breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
