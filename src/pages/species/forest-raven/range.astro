const breadcrumbs = [
  { name: 'Home',         url: '/' },
  { name: 'Species',      url: '/species/' },
  { name: 'Forest Raven', url: '/species/forest-raven/' },
  { name: 'Range',        url: path },
];

const faq = [
  { q: 'Where does the Forest Raven live?', a: 'The Forest Raven (Corvus tasmanicus) has a disjunct range: it is the dominant large corvid on Tasmania (the entire island), and also occurs in small areas of mainland Australia — coastal Victoria (including the Otway ranges and Wilsons Promontory), extreme coastal South Australia (Kangaroo Island and the southern Mt Lofty Ranges), and far south-eastern New South Wales (south coast ranges). On the mainland, its range is fragmented and largely restricted to coastal and montane areas with tall wet forest.' },
  { q: 'Is the Forest Raven the same as the Tasmanian Raven?', a: 'Sometimes used as an alternative name. "Forest Raven" is the standard English name in HANZAB and most Australian bird references; some older texts use "Tasmanian Raven" emphasising its stronghold on the island. It is not a separate species — Corvus tasmanicus applies to both the Tasmanian and mainland populations. The mainland populations are sometimes treated as a separate subspecies (C. t. boreus) based on slightly larger size.' },
  { q: 'Is the Forest Raven threatened?', a: 'The Forest Raven is not globally threatened — it is classified as Least Concern by IUCN. The Tasmanian population is robust. However, the mainland Australian populations (coastal Victoria and South Australia) are small and potentially at risk from habitat loss of tall wet forest. The species is relatively sedentary and dependent on tall trees for nesting, making it sensitive to forest clearing in its limited mainland strongholds.' },
];
