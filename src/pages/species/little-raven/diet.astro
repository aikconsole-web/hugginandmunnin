const title       = 'Little Raven Diet: What This Species Eats';
const description = 'The Little Raven of south-eastern Australia is a highly mobile, flocking omnivore with a diet dominated by invertebrates. It exploits semi-arid grasslands, farmland, and alpine habitats for insects, seeds, carrion, and food waste.';
const path        = '/species/little-raven/diet/';

const breadcrumbs = [
  { name: 'Home',         url: '/' },
  { name: 'Species',      url: '/species/' },
  { name: 'Little Raven', url: '/species/little-raven/' },
  { name: 'Diet',         url: path },
];

const faq = [
  { q: 'What does the Little Raven eat?', a: 'The Little Raven eats primarily invertebrates — beetles, grasshoppers, caterpillars, and other insects — along with seeds, grain, small vertebrates, carrion, and human food waste. Its diet is similar to that of the Australian Raven and Forest Raven but with a relatively higher emphasis on invertebrates, reflecting its preference for open grassland, semi-arid, and alpine habitats where insects can be very abundant seasonally.' },
  { q: 'How is the Little Raven different from the Australian Raven in diet?', a: 'The Little Raven is smaller than the Australian Raven and tends to forage in more open, semi-arid, and alpine habitats. Its diet reflects this — a relatively greater proportion of invertebrates and less reliance on carrion compared to the Australian Raven. The Little Raven is also a more highly nomadic, flocking species; its foraging is adapted to moving rapidly between areas of insect abundance, particularly during grasshopper and locust eruptions.' },
  { q: 'Do Little Ravens eat grain?', a: 'Yes. Little Ravens eat cereal grain (wheat, barley, oats) in agricultural areas, particularly in fields after sowing and during harvest. The species can form large flocks in agricultural regions — both while foraging for insects and when exploiting grain. Flocks following machinery are documented. Its grain consumption is a source of conflict with farmers in some parts of south-eastern Australia.' },
];
---

