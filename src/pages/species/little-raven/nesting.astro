const title       = 'Little Raven Nesting: Breeding Season and Nest Sites';
const description = 'The Little Raven — Australia\'s most nomadic corvid — breeds in tall eucalypts in south-eastern Australia from July to October. This page covers nest structure, clutch size, incubation, and the breeding behaviour of Corvus mellori.';
const path        = '/species/little-raven/nesting/';

const breadcrumbs = [
  { name: 'Home',         url: '/' },
  { name: 'Species',      url: '/species/' },
  { name: 'Little Raven', url: '/species/little-raven/' },
  { name: 'Nesting',      url: path },
];

const faq = [
  { q: 'Where does the Little Raven nest?', a: 'The Little Raven nests in trees — typically tall eucalypts in open woodland, alpine woodland, mallee scrub, or farmland with scattered trees. Despite being Australia\'s most nomadic corvid (flocks roam widely outside the breeding season), pairs settle into territories and nest in fixed sites for the breeding season. The nest is placed in the fork or on a stout branch, usually in the upper canopy.' },
  { q: 'When does the Little Raven breed?', a: 'The Little Raven breeds from approximately July to November — Southern Hemisphere late-winter through spring. Egg-laying typically peaks August–September in most of its range, which extends from south-eastern Queensland through New South Wales, Victoria, South Australia, and into south-western Western Australia.' },
  { q: 'Is the Little Raven different from the Australian Raven?', a: 'Yes. The Little Raven (Corvus mellori) is a distinct species, smaller than the Australian Raven (Corvus coronoides) with a slightly different call (a rapid "ark-ark-ark" rather than the Australian Raven\'s drawn-out wail). The Little Raven is also more nomadic and more gregarious outside the breeding season, often forming large post-breeding flocks. Where ranges overlap, the two species can be difficult to distinguish in the field.' },
];
---

