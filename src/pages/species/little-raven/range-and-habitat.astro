---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title       = 'Little Raven Range and Habitat — South-Eastern Australia';
const description = 'The Little Raven (Corvus mellori) is restricted to south-eastern Australia — Victoria, South Australia, southern NSW, and south-west WA. Range, habitat, and flocking behaviour.';
const path        = '/species/little-raven/range-and-habitat/';

const breadcrumbs = [
  { name: 'Home',         url: '/' },
  { name: 'Species',      url: '/species/' },
  { name: 'Little Raven', url: '/species/little-raven/' },
  { name: 'Range and Habitat', url: path },
];

const faq = [
  { q: 'Where does the Little Raven live?', a: 'The Little Raven is found in south-eastern Australia — Victoria, South Australia, southern New South Wales, the Australian Capital Territory, and a disjunct population in south-west Western Australia. It is not found in Queensland, the Northern Territory, or northern Western Australia. It favours open woodland, alpine and subalpine areas, and agricultural land.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

<article class="id-page">
  <nav class="id-breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
            ? <><a href={b.url}>{b.name}</a><span aria-hidden="true"> › </span></>
            : <span aria-current="page">{b.name}</span>}
        </li>
      ))}
    </ol>
  </nav>
  <header class="id-header">
    <p class="id-pillar">Species · Range and Habitat</p>
    <h1>Little Raven — Range and Habitat</h1>
    <p class="id-subtitle"><em>Corvus mellori</em> · South-Eastern Australia</p>
  </header>

  <section class="id-snippet" aria-label="Quick answer">
    <p><strong class="claim-science">[science]</strong> The Little Raven is restricted to south-eastern Australia — Victoria, South Australia, southern NSW, the ACT, and a separate population in south-west Western Australia. It favours open woodland, alpine grassland, and agricultural land. Forms large winter flocks (sometimes hundreds of birds). Conservation status: Least Concern.</p>
  </section>

  <section class="id-section">
    <h2>Range</h2>
    <p><strong class="claim-science">[science]</strong></p>
    <ul>
      <li><strong>Victoria:</strong> Throughout — widespread and common</li>
      <li><strong>South Australia:</strong> South and south-east; also Eyre Peninsula</li>
      <li><strong>New South Wales:</strong> Southern tablelands and slopes, Snowy Mountains, ACT region</li>
      <li><strong>Western Australia:</strong> South-west corner (disjunct population around Perth and south-west WA)</li>
      <li>Absent from Queensland, Northern Territory, and tropical north<sup><a href="#src-1">1</a></sup></li>
    </ul>
  </section>

  <section class="id-section">
    <h2>Habitat</h2>
    <p><strong class="claim-science">[science]</strong></p>
    <ul>
      <li>Open eucalypt woodland and mallee scrub</li>
      <li>Alpine and subalpine grassland — more common at altitude than Australian Raven in some areas</li>
      <li>Agricultural pasture and cropland</li>
      <li>Suburban areas in Melbourne and other south-eastern cities</li>
    </ul>
    <p>Little Ravens are more nomadic than Australian Ravens — they move in response to food availability and form large flocks outside the breeding season. Winter flocks of hundreds are typical in agricultural areas of Victoria and South Australia.<sup><a href="#src-1">1</a></sup></p>
  </section>

  <section class="id-section">
    <h2>Conservation Status</h2>
    <p><strong class="claim-science">[science]</strong> <strong>Least Concern</strong> (IUCN Red List). Common within its restricted south-eastern range.</p>
  </section>

  <section class="id-faq id-section" aria-labelledby="faq-h2">
    <h2 id="faq-h2">Frequently Asked Questions</h2>
    {faq.map(item => (
      <details class="id-faq-item">
        <summary class="id-faq-q">{item.q}</summary>
        <p class="id-faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <section class="id-sources id-section" aria-labelledby="src-h2">
    <h2 id="src-h2">Sources</h2>
    <ol class="id-src-list">
      <li id="src-1">Madge, S. &amp; Burn, H. (1994). <em>Crows and Jays</em>. Christopher Helm. — range and habitat.</li>
    </ol>
    <p class="id-claim-note"><strong class="claim-science">[science]</strong> field-guide data</p>
  </section>

  <nav class="id-nav-bottom">
    <a href="/species/little-raven/identification/" class="id-back">← Identification</a>
    <a href="/species/little-raven/" class="id-next">Little Raven Overview →</a>
  </nav>
</article>
</BaseLayout>

<style>
  .id-page { max-width: 820px; margin: 0 auto; padding: 2rem 1.25rem 4rem; color: var(--iron-ink, #e8e4d8); font-family: 'Inter', sans-serif; line-height: 1.72; }
  .id-breadcrumb ol { display: flex; flex-wrap: wrap; gap: .25rem; list-style: none; padding: 0; margin: 0 0 2rem; font-size: .8rem; color: var(--ink-soft, #8a8070); }
  .id-breadcrumb a { color: var(--gold-500, #d4ae5a); text-decoration: none; }
  .id-pillar { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-500, #d4ae5a); margin: 0 0 .4rem; }
  .id-page h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 700; color: #fff; margin: 0 0 .2rem; line-height: 1.1; }
  .id-subtitle { font-size: 1rem; color: var(--ink-soft, #c0b89a); margin: 0 0 2rem; }
  .id-snippet { background: rgba(212,174,90,.08); border-left: 3px solid var(--gold-500, #d4ae5a); border-radius: 0 6px 6px 0; padding: 1rem 1.25rem; margin-bottom: 2.5rem; font-size: 1.03rem; }
  .id-section { margin-bottom: 2.75rem; }
  .id-section h2 { font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 600; color: #fff; margin: 0 0 1rem; border-bottom: 1px solid rgba(212,174,90,.2); padding-bottom: .4rem; }
  .id-section p { margin: 0 0 1rem; font-size: .97rem; }
  .id-section ul { padding-left: 1.25rem; margin: 0 0 1rem; }
  .id-section li { margin-bottom: .4rem; font-size: .95rem; }
  .claim-science { color: #7ab9e0; font-style: normal; font-size: .78rem; }
  a[href] { color: var(--gold-500, #d4ae5a); }
  .id-faq-item { border-bottom: 1px solid rgba(255,255,255,.07); }
  .id-faq-q { cursor: pointer; padding: .9rem 0; font-size: .97rem; font-weight: 500; color: #fff; list-style: none; }
  .id-faq-q::before { content: '+ '; color: var(--gold-500, #d4ae5a); font-weight: 700; }
  details[open] .id-faq-q::before { content: '− '; }
  .id-faq-a { margin: 0 0 1rem; line-height: 1.7; font-size: .93rem; color: var(--ink-soft, #c8c0b0); }
  .id-src-list { padding-left: 1.25rem; margin: 0 0 1rem; }
  .id-src-list li { margin-bottom: .6rem; font-size: .82rem; color: var(--ink-soft, #8a8070); line-height: 1.6; }
  .id-claim-note { font-size: .78rem; color: var(--ink-soft, #605848); border-top: 1px solid rgba(255,255,255,.06); padding-top: .75rem; }
  .id-nav-bottom { display: flex; justify-content: space-between; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,.07); }
  .id-nav-bottom a { font-size: .9rem; text-decoration: none; }
  .id-nav-bottom a:hover { text-decoration: underline; }
</style>
