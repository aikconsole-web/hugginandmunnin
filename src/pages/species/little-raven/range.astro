---
/**
 * Species sub-page — Little Raven range
 * SPC·09r
 * Primary keyword: little raven range
 * Secondary: where does the little raven live, corvus mellori range, little raven australia
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title       = 'Little Raven Range: Where This Species Lives';
const description = 'The Little Raven is Australia\'s most nomadic corvid, with a breeding range in south-eastern Australia and a non-breeding range extending through arid eastern Australia. This page covers its distribution, habitat, and nomadic movements.';
const path        = '/species/little-raven/range/';

const breadcrumbs = [
  { name: 'Home',         url: '/' },
  { name: 'Species',      url: '/species/' },
  { name: 'Little Raven', url: '/species/little-raven/' },
  { name: 'Range',        url: path },
];

const faq = [
  { q: 'Where does the Little Raven live?', a: 'The Little Raven (Corvus mellori) breeds in open woodland and montane areas of south-eastern Australia — south-east Queensland, New South Wales (especially the tablelands and ranges), Victoria, South Australia, and south-western Western Australia. Outside the breeding season (November–May), nomadic flocks wander widely through agricultural and semi-arid areas of south-eastern and eastern Australia, following food resources. Its non-breeding range extends well north of its breeding range.' },
  { q: 'Is the Little Raven different from the Australian Raven?', a: 'Yes — the Little Raven (Corvus mellori) is a distinct species, smaller (45–50 cm, 350–450 g) than the Australian Raven (Corvus coronoides, 46–53 cm but heavier at 540–820 g). The two species overlap extensively in south-eastern Australia. The Little Raven is more gregarious, more nomadic, and in the hand shows different eye colour (white adult iris) versus the Australian Raven\'s white iris with a narrow white outer ring. Voice: Little Raven gives a rapid "ark-ark-ark"; Australian Raven a drawn-out wailing call.' },
  { q: 'Where are the best places to see Little Ravens?', a: 'Large post-breeding flocks of Little Ravens are most easily seen in open farmland and grain-growing areas of south-eastern Australia in autumn and winter — where they gather around harvested paddocks, roadkill, and invertebrate-rich agricultural land. Wheat and canola fields in central New South Wales, Victoria, and South Australia can hold hundreds or thousands of birds. During the breeding season, montane woodland and alpine areas of the Australian Alps and south-east NSW tablelands are productive.' },
];
---

<BaseLayout title={title} description={description} path={path} ogType="article"
  datePublished="2026-11-07" dateModified="2026-11-07"
  breadcrumbs={breadcrumbs} faq={faq} pageType="Article">

<article class="qa-page">

  <nav class="qa-breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumbs.map((b, i) => (
        <li>
          {i < breadcrumbs.length - 1
            ? <><a href={b.url}>{b.name}</a><span aria-hidden="true"> › </span></>
            : <span aria-current="page">{b.name}</span>}
        </li>
      ))}
    </ol>
  </nav>

  <header class="qa-header">
    <p class="qa-pillar">Species Sub-page · SPC·09r</p>
    <h1>Little Raven Range: Where This Species Lives</h1>
  </header>

  <section class="qa-snippet" aria-label="Direct answer">
    <p><strong class="claim-science">[science]</strong> The Little Raven (<em>Corvus mellori</em>) breeds in open woodland, montane areas, and mallee of south-eastern Australia — from southern Queensland through New South Wales, Victoria, and South Australia to south-western Western Australia. After breeding, nomadic flocks travel widely through agricultural and semi-arid eastern Australia. It is the most nomadic of Australia's corvids, and large winter flocks can appear far from breeding areas.</p>
  </section>

  <section class="qa-section">
    <h2>Breeding Range</h2>
    <p><strong class="claim-science">[science]</strong> During the breeding season (July–November), Little Ravens are found in:<sup><a href="#src-1">1</a></sup></p>
    <ul>
      <li><strong>New South Wales:</strong> tablelands, ranges, and southern slopes — most abundant in the South West Slopes and Monaro Tablelands; extends to the Australian Alps in alpine and subalpine habitats.</li>
      <li><strong>Victoria:</strong> throughout — common in farmland, alpine areas, and mallee of the Wimmera and Murray Mallee.</li>
      <li><strong>South Australia:</strong> Mount Lofty Ranges, Flinders Ranges, and the Murray Mallee.</li>
      <li><strong>Western Australia (south-west):</strong> the south-west corner, with breeding in wheat belt and mallee areas.</li>
      <li><strong>South-east Queensland:</strong> Darling Downs and south-east Queensland highlands (northern limit of regular breeding).</li>
    </ul>
  </section>

  <section class="qa-section">
    <h2>Non-Breeding (Nomadic) Range</h2>
    <p><strong class="claim-science">[science]</strong> After fledging, juvenile and adult Little Ravens form large nomadic flocks that wander extensively:<sup><a href="#src-1">1</a></sup></p>
    <ul>
      <li>Flocks track invertebrate eruptions, particularly after summer rainfall events that produce locust and grasshopper outbreaks in inland eastern Australia.</li>
      <li>Agricultural areas with grain stubble, canola, and irrigated crops attract large winter aggregations.</li>
      <li>Non-breeding birds range north into central Queensland and western New South Wales — well beyond the breeding range.</li>
      <li>Flock sizes can reach hundreds to occasionally thousands of birds at rich food resources.</li>
    </ul>
  </section>

  <section class="qa-section">
    <h2>Related Pages</h2>
    <ul>
      <li><a href="/species/little-raven/">Little Raven — species hub</a></li>
      <li><a href="/species/little-raven/identification/">Little Raven identification</a></li>
      <li><a href="/compare/australian-raven-vs-little-raven/">Australian Raven vs Little Raven</a></li>
      <li><a href="/species/australian-raven/range/">Australian Raven range</a></li>
    </ul>
  </section>

  <section class="qa-faq qa-section" aria-labelledby="faq-h2">
    <h2 id="faq-h2">Frequently Asked Questions</h2>
    {faq.map(item => (
      <details class="qa-faq-item">
        <summary class="qa-faq-q">{item.q}</summary>
        <p class="qa-faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <section class="qa-sources qa-section" aria-labelledby="src-h2">
    <h2 id="src-h2">Sources</h2>
    <ol class="qa-src-list">
      <li id="src-1">Higgins, P.J., Peter, J.M. & Cowling, S.J. (eds., 2006). <em>Handbook of Australian, New Zealand and Antarctic Birds</em> (HANZAB), vol. 7. Oxford University Press. — Little Raven species account; breeding range, nomadic movements, habitat.</li>
    </ol>
    <p class="qa-claim-note"><strong class="claim-science">[science]</strong> peer-reviewed or field-guide data</p>
  </section>

</article>
</BaseLayout>

