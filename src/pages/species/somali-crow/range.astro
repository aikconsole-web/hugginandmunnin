const breadcrumbs = [
  { name: 'Home',       url: '/' },
  { name: 'Species',    url: '/species/' },
  { name: 'Somali Crow', url: '/species/somali-crow/' },
  { name: 'Range',      url: path },
];

const faq = [
  { q: 'Where does the Somali Crow live?', a: 'The Somali Crow (Corvus edithae) is confined to a small area in the Horn of Africa — primarily in Somalia, with some records from adjacent Djibouti and eastern Ethiopia (the Ogaden region). It is essentially a Somali endemic. Its range appears to be centred on the arid thorn-scrub and open country of central and northern Somalia, but precise distributional data are extremely limited due to the difficulty of ornithological fieldwork in Somalia.' },
  { q: 'Is the Somali Crow related to the Brown-necked Raven?', a: 'Yes. The Somali Crow (Corvus edithae) is closely related to the Brown-necked Raven (Corvus ruficollis) and was formerly treated as a subspecies of it. Current taxonomy (IOC World Bird List and HBW) recognises it as a full species based on its smaller size (the "Dwarf Raven" name reflects its notably small body), differences in bill proportions, and its restricted distribution. The two taxa are allopatric — the Somali Crow occupying a core Somali range, the Brown-necked Raven surrounding it to the north, west, and east.' },
  { q: 'Why is the Somali Crow so poorly studied?', a: 'The Somali Crow is poorly studied because Somalia has been in a state of prolonged civil conflict and institutional instability since the early 1990s, making sustained ornithological fieldwork essentially impossible. Most knowledge of the species comes from museum specimens collected before 1990 and brief field observations by researchers passing through the region. The species may be more widespread than current records suggest, or more restricted — without systematic surveys, it is impossible to know.' },
];
