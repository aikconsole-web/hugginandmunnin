const title       = 'Thick-billed Raven Nesting: Breeding and Nest Sites';
const description = 'The Thick-billed Raven nests on cliff faces and rocky outcrops in the Ethiopian Highlands. This page covers nest structure, egg number, incubation, and the breeding season of this largest of all ravens.';
const path        = '/species/thick-billed-raven/nesting/';

const breadcrumbs = [
  { name: 'Home',              url: '/' },
  { name: 'Species',           url: '/species/' },
  { name: 'Thick-billed Raven', url: '/species/thick-billed-raven/' },
  { name: 'Nesting',           url: path },
];

const faq = [
  { q: 'Where does the Thick-billed Raven nest?', a: 'The Thick-billed Raven nests almost exclusively on cliff faces and rocky outcrops. Its nest sites are typically on ledges or in cavities on steep rock faces in the Ethiopian Highlands and Eritrean mountains. This cliff-nesting habit is shared with other large highland corvids and reflects the bird\'s strong association with rocky, montane terrain. Nests on buildings and structures have occasionally been reported in areas where suitable rock faces are absent.' },
  { q: 'How many eggs does the Thick-billed Raven lay?', a: 'The Thick-billed Raven typically lays 3–5 eggs per clutch, consistent with other large raven species. Eggs are pale blue-green to greenish-white, heavily blotched with brown and grey markings. Incubation is by the female, lasting approximately 20–21 days. Both parents care for the young after hatching.' },
  { q: 'When does the Thick-billed Raven breed?', a: 'Breeding in the Ethiopian Highlands typically occurs between January and June, with peak egg-laying in February and March. This timing aligns with the driest part of the highland year, before the main rains. Like most large corvids, the Thick-billed Raven is a relatively early breeder.' },
];
