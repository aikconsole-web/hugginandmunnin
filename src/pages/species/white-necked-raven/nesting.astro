const path        = '/species/white-necked-raven/nesting/';

const breadcrumbs = [
  { name: 'Home',               url: '/' },
  { name: 'Species',            url: '/species/' },
  { name: 'White-necked Raven', url: '/species/white-necked-raven/' },
  { name: 'Nesting',            url: path },
];

const faq = [
  { q: 'Where does the White-necked Raven nest?', a: 'The White-necked Raven nests almost exclusively on cliff faces and rocky outcrops. It is a strongly cliff-associated species, and its nest sites are typically on ledges or in crevices on steep rock faces in montane habitats across eastern and southern Africa. In areas where natural cliffs are scarce, it may nest on large buildings, bridges, or rock quarry faces.' },
  { q: 'When does the White-necked Raven breed?', a: 'Breeding season varies across the species\' wide range. In East Africa (Kenya, Tanzania, Ethiopia), breeding is documented from approximately July to October — coinciding with the drier periods between the main rains. In South Africa, breeding occurs from about July to November. These timing differences reflect local climatic conditions rather than a fixed continental calendar.' },
  { q: 'How many eggs does the White-necked Raven lay?', a: 'Clutch size is typically 3–5 eggs, consistent with other large raven species. Eggs are pale blue-green to greenish-white, heavily blotched with brown and grey. Incubation is approximately 20–21 days, primarily by the female while the male provides food. Both parents care for the young after hatching; fledging occurs at approximately 6 weeks.' },
];
